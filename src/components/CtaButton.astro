---
import { translator } from '../i18n';
const t = translator(Astro.currentLocale);
/* Hlavní tlačítko „pill + kruh se šipkou“. Stavy podle rámce Button States v Penu.
   Hover: kruh zbělá, šipka odjede ve svém směru (↗) a zespodu zleva přijede nová. */
import AnimatedArrow from './AnimatedArrow.astro';

interface Props {
  href?: string;
  label?: string;
  size?: 'md' | 'sm';
  full?: boolean;
  type?: 'button' | 'submit';
  openForm?: boolean;
  class?: string;
}
const {
  href = '#kontakt',
  label = t('Poptat web', 'Get more enquiries'),
  size = 'md',
  full = false,
  type,
  openForm = true,
  class: className,
} = Astro.props;
const cls = ['cta', `cta--${size}`, full && 'cta--full', className].filter(Boolean).join(' ');
const iconSize = size === 'sm' ? 15 : 18;
---

{
  type ? (
    <button class={cls} type={type}>
      <span>{label}</span>
      <span class="cta-arrow">
        <AnimatedArrow size={iconSize} />
      </span>
    </button>
  ) : (
    <a class={cls} href={href} data-open-form={openForm ? '' : undefined}>
      <span>{label}</span>
      <span class="cta-arrow">
        <AnimatedArrow size={iconSize} />
      </span>
    </a>
  )
}

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 56px;
    padding: 0 8px 0 28px;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font);
    font-size: 18px;
    line-height: 28px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease), transform 0.15s var(--ease);
  }
  .cta-arrow {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    overflow: hidden;
    border-radius: 999px;
    background: var(--on-accent);
    color: var(--light);
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .cta:hover { background: var(--ink-hover); color: var(--light); }
    .cta:hover .cta-arrow { background: var(--light); color: var(--on-accent); }
  }
  .cta:active { transform: scale(0.98); }
  .cta:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; border-radius: 999px; }
  :global(.on-dark) .cta:focus-visible { outline-color: var(--on-dark); }

  .cta--sm { height: 44px; gap: 10px; padding: 0 6px 0 18px; font-size: 15px; line-height: 1.2; }
  .cta--sm .cta-arrow { width: 32px; height: 32px; }
  .cta--full { width: 100%; }

  @media (prefers-reduced-motion: reduce) {
    .cta, .cta-arrow { transition: none; }
  }
</style>
