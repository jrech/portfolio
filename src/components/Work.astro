---
import { getLocale, localeLinks, translator } from '../i18n';
const t = translator(Astro.currentLocale);
import { Picture } from 'astro:assets';
import AnimatedArrow from './AnimatedArrow.astro';
import pradelna from '../assets/img/pradelna-card-stolek.webp';
import senk from '../assets/img/senk-card-stul.webp';
import etecsa from '../assets/img/etecsa-iphone.webp';

/* href jen tam, kde existuje case study. Ostatní karty jsou bez odkazu (div) se štítkem „Připravujeme“, dokud stránky nevzniknou. */
const items = [
  {
    title: t('Hotely si ověří svoz a poptají praní.', 'Hotels check collection areas and request a quote.'),
    meta: t('Prádelna Krkonoše · identita, web, texty', 'Prádelna Krkonoše · branding, website, copy'),
    img: pradelna,
    pos: '50% 46%', // 2:3 fotka: o kousek výš, ať obrazovka notebooku zůstane nad textem
    alt: t('Web Prádelny Krkonoše na notebooku na dřevěném stolku v pokoji', 'Prádelna Krkonoše website on a laptop on a wooden side table in a room'),
    href: localeLinks('/work/pradelna-krkonose')[getLocale(Astro.currentLocale)],
  },
  {
    title: t('Úpravy webu Starobrněnského šenku', 'Website updates for Starobrněnský šenk'), // [OVĚŘIT] stav zakázky
    meta: t('Starobrněnský šenk · strategie, web, texty', 'Starobrněnský šenk · strategy, website, copy'),
    img: senk,
    pos: '50% 50%',
    alt: t('Web Starobrněnského šenku na mobilu položeném na tmavém dřevěném stole: fotka interiéru hospody a nadpis „Po práci na jedno. A něco k tomu.“', 'Starobrněnský šenk website on a phone lying on a dark wooden table, showing the pub interior and the headline “Po práci na jedno. A něco k tomu.”'),
    href: null,
  },
  {
    title: t('Mobilní tarify a domácí internet na webu ETECSA', 'Mobile plans and home internet on the ETECSA website'),
    meta: t('ETECSA · koncept redesignu', 'ETECSA · redesign concept'),
    img: etecsa,
    pos: '50% 50%',
    alt: t('Web ETECSA na iPhonu', 'ETECSA website on an iPhone'),
    href: null,
  },
];
---

<section class="work container" id="prace" aria-labelledby="prace-h">
  <h2 class="h2" id="prace-h" data-reveal data-reveal-load>{t('Vybrané práce', 'Selected work')}</h2>
  <ul class="cards">
    {
      items.map((it) => {
        const Tag = it.href ? 'a' : 'div';
        return (
          <li data-reveal-item data-reveal-load>
            <Tag class="card" href={it.href ?? undefined}>
              <span class="card-media" style={`--pos: ${it.pos}`}>
                <Picture
                  class="card-img"
                  src={it.img}
                  alt={it.alt}
                  formats={['avif', 'webp']}
                  widths={[400, 640, 820, 1080, 1200]}
                  sizes="(max-width: 700px) calc(100vw - 32px), (max-width: 1440px) 30vw, 405px"
                  quality={90}
                />
              </span>
              <span class="card-bottom">
                <span class="card-text">
                  <span class="card-title">{it.title}</span>
                  <span class="card-meta">{it.meta}</span>
                </span>
                {it.href && (
                  <span class="study-link">
                    {t('Případová studie', 'Case study')}
                    <span class="card-arrow" aria-hidden="true"><AnimatedArrow /></span>
                  </span>
                )}
                {!it.href && (
                  <span class="study-link is-soon">
                    {t('Připravujeme', 'Coming soon')}
                    <span class="card-arrow" aria-hidden="true"><AnimatedArrow /></span>
                  </span>
                )}
              </span>
            </Tag>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .work { display: flex; flex-direction: column; gap: 48px; padding-block: var(--sec-y); }
  /* skryté do úvodní animace (motion.ts → workIntro / reveals); bez JS a s reduced-motion chybí .anim, takže je vše vidět */
  :global(.anim) [data-reveal-load]:not([data-revealed]) { opacity: 0; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    /* všechny karty stejně vysoké bez ohledu na poměr stran fotky; fotka kartu vždy celou vyplní */
    aspect-ratio: 5 / 6;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: #161616;
    color: var(--on-dark);
    text-decoration: none;
    isolation: isolate;
  }
  .card-bottom { grid-area: 1 / 1; }
  .card-media { position: absolute; inset: 0; z-index: -1; }
  /* najetí na kartu (nebo fokus klávesnicí): ostatní karty se jemně ztmaví.
     Jen na zařízeních s myší; s reduced-motion bez přechodu. */
  @media (hover: hover) and (pointer: fine) {
    .card { transition: filter 0.35s var(--ease); }
    .cards:has(.card:hover, .card:focus-visible) .card:not(:hover, :focus-visible) { filter: brightness(0.75); }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: reduce) {
    .card { transition: none; }
  }
  .card-media :global(picture) { display: contents; }
  .card :global(.card-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
  }
  .card-bottom {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: 22px 24px 24px;
  }
  .card-bottom::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -36px 0 0;
    background: linear-gradient(to bottom, transparent, rgb(0 0 0 / 0.62) 42%, rgb(0 0 0 / 0.84));
    pointer-events: none;
  }
  /* karta bez case study: stejný štítek, ale tlumený a bez interakce */
  .is-soon { color: rgb(238 233 223 / 0.8); }
  .is-soon .card-arrow { opacity: 0.45; }
  .study-link { display: inline-flex; gap: 10px; align-items: center; font-size: 15px; font-weight: 600; }
  .study-link .card-arrow { width: 32px; height: 32px; }
  .card-text { display: flex; flex-direction: column; gap: 8px; }
  .card-title { font-size: 24px; line-height: 29px; font-weight: 600; text-wrap: balance; }
  .card-meta { font-size: 15px; line-height: 23px; color: rgb(238 233 223 / 0.8); }
  .card-arrow {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: var(--on-dark);
    color: var(--on-accent);
    overflow: hidden;
    transition: background-color 0.2s var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    a.card:hover .card-arrow { background: var(--accent); }
  }
  a.card:focus-visible { outline: 2px solid var(--text); outline-offset: 4px; border-radius: var(--radius-card); }

  @media (min-width: 701px) {
    .work { padding-top: 24px; }
    .cards { gap: clamp(14px, 2vw, 32px); }
  }
  @media (701px <= width <= 1000px) {
    .card-bottom { gap: 12px; padding: 14px; }
    .card-title { font-size: 21px; line-height: 26px; }
    .card-meta, .study-link { font-size: 14px; line-height: 20px; }
  }
  @media (max-width: 700px) {
    .work { gap: 32px; padding-top: 0; }
    .cards { grid-template-columns: 1fr; gap: 16px; }
    .card-bottom { padding: 18px 20px 20px; }
    /* na mobilu leží text přes obrazovku telefonu: delší a tmavší přechod, ať se čte klidně */
    .card-bottom::before { inset: -96px 0 0; background: linear-gradient(to bottom, transparent, rgb(0 0 0 / 0.74) 36%, rgb(0 0 0 / 0.9)); }
  }
</style>
