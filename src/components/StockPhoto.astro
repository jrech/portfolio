---
/* Ilustrace „fotky z fotobanky“ pro maketu starého webu (Problems): usměvavý tým v obleku u notebooku,
   přesycené barvy a vodoznak. Vlastní SVG, žádný stažený obrázek. */
interface Props {
  watermark: string;
}
const { watermark } = Astro.props;
const people = [
  { x: 214, skin: '#f2c4a0', hair: '#5a3825', suit: '#2b3f66', tie: '#c0392b', scale: 1 },
  { x: 318, skin: '#e8b48c', hair: '#2d2018', suit: '#3c4656', tie: '#2e7dd1', scale: 1.06 },
  { x: 426, skin: '#f5cfb0', hair: '#c9932f', suit: '#24365c', tie: null, scale: 1.02 },
  { x: 528, skin: '#d9a17a', hair: '#1d1612', suit: '#4a4f5c', tie: '#8e44ad', scale: 0.98 },
];
---

<svg class="stock" viewBox="0 0 733 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="sp-wall" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#eaf6ff" />
      <stop offset="1" stop-color="#bfe0f7" />
    </linearGradient>
    <linearGradient id="sp-window" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#9fd3ff" />
    </linearGradient>
    <linearGradient id="sp-desk" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#d9e3ec" />
    </linearGradient>
    <radialGradient id="sp-glow" cx="0.5" cy="0.35" r="0.6">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.85" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
    <pattern id="sp-wm" width="190" height="70" patternUnits="userSpaceOnUse" patternTransform="rotate(-22)">
      <text x="0" y="40" font-family="Verdana, Arial, sans-serif" font-size="22" font-weight="700" letter-spacing="3" fill="#fff" fill-opacity="0.32">{watermark}</text>
    </pattern>
  </defs>

  <!-- kancelář: zeď, okna, rostlina -->
  <rect width="733" height="180" fill="url(#sp-wall)" />
  <g fill="url(#sp-window)" stroke="#d4ebfb" stroke-width="3">
    <rect x="22" y="14" width="130" height="112" rx="2" />
    <rect x="590" y="14" width="124" height="112" rx="2" />
  </g>
  <path d="M87 14v112M22 70h130M652 14v112M590 70h124" stroke="#d4ebfb" stroke-width="3" />
  <ellipse cx="366" cy="60" rx="300" ry="90" fill="url(#sp-glow)" />
  <g>
    <rect x="160" y="118" width="22" height="26" rx="3" fill="#e9eef3" />
    <path d="M171 120c-14-14-20-34-12-46 6 12 10 24 12 46zm0 0c6-20 18-34 30-36-6 16-16 28-30 36zm0 0c-4-24 0-44 8-54 4 18 0 38-8 54z" fill="#3fbf5a" />
  </g>

  <!-- lidé -->
  {
    people.map((p) => (
      <g transform={`translate(${p.x} 0) scale(${p.scale}) translate(0 ${(1 - p.scale) * 150})`}>
        <path d="M-44 180c0-38 18-62 44-62s44 24 44 62z" fill={p.suit} />
        <path d="M-12 120l12 34 12-34z" fill="#ffffff" />
        {p.tie && <path d="M-4 124h8l3 30-7 8-7-8z" fill={p.tie} />}
        <rect x="-8" y="98" width="16" height="22" rx="6" fill={p.skin} />
        <ellipse cx="0" cy="80" rx="23" ry="27" fill={p.skin} />
        <path d="M-24 76c0-20 12-32 26-32 15 0 24 12 22 30-6-10-16-14-26-14-10 0-17 6-22 16z" fill={p.hair} />
        <circle cx="-8" cy="80" r="2.4" fill="#2b1d14" />
        <circle cx="8" cy="80" r="2.4" fill="#2b1d14" />
        <path d="M-10 90q10 11 20 0" stroke="#8a3b2a" stroke-width="2.6" fill="#ffffff" stroke-linecap="round" />
        <ellipse cx="-14" cy="88" rx="5" ry="3" fill="#ff8a7a" fill-opacity="0.35" />
        <ellipse cx="14" cy="88" rx="5" ry="3" fill="#ff8a7a" fill-opacity="0.35" />
      </g>
    ))
  }

  <!-- stůl s notebookem a hrnkem -->
  <path d="M120 150h493l26 30H94z" fill="url(#sp-desk)" />
  <path d="M120 150h493" stroke="#ffffff" stroke-width="2" />
  <g transform="translate(330 120)">
    <path d="M0 0h74l-4 30H4z" fill="#c9d3dd" />
    <path d="M4 3h66l-3 24H7z" fill="#5aa9f0" />
    <path d="M-12 30h98l6 8H-18z" fill="#aeb9c4" />
  </g>
  <g transform="translate(470 134)">
    <rect width="16" height="18" rx="3" fill="#ffffff" stroke="#e05a2b" stroke-width="2" />
    <path d="M16 5c6 0 6 9 0 9" stroke="#e05a2b" stroke-width="2" fill="none" />
  </g>

  <!-- vodoznak fotobanky -->
  <rect width="733" height="180" fill="url(#sp-wm)" />
</svg>

<style>
  .stock { display: block; width: 100%; height: 100%; }
</style>
