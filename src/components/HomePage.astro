---
import BaseLayout from '../layouts/BaseLayout.astro';
import arrowDownRightIcon from '@phosphor-icons/core/assets/regular/arrow-down-right.svg?raw';
import menuIcon from '@phosphor-icons/core/assets/regular/list.svg?raw';
import closeIcon from '@phosphor-icons/core/assets/regular/x.svg?raw';
import cs from '../i18n/cs.json';
import en from '../i18n/en.json';

interface Props { lang: 'cs' | 'en' }
const { lang } = Astro.props;
const isCs = lang === 'cs';

const t = isCs ? cs : en;
---
<BaseLayout lang={lang} title={t.title} description={t.description}>
  <div class="cursor" data-cursor aria-hidden="true"><span data-cursor-label></span></div>
  <header class="site-header" data-header>
    <a class="wordmark" data-magnetic href={`/${lang}/`} aria-label="Jonas Rech — home">jonasrech<span>.</span></a>
    <nav class="desktop-nav" aria-label={isCs ? 'Hlavní navigace' : 'Primary navigation'}>
      <a href="#work">{t.nav[0]}</a>
      <a href="#about">{t.nav[2]}</a>
      <a href="#contact">{t.nav[3]}</a>
    </nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
      <span class="sr-only">{isCs ? 'Otevřít menu' : 'Open menu'}</span>
      <span class="menu-toggle__icon menu-toggle__list" aria-hidden="true" set:html={menuIcon}></span>
      <span class="menu-toggle__icon menu-toggle__close" aria-hidden="true" set:html={closeIcon}></span>
    </button>
  </header>
  <aside class="site-menu" id="site-menu" aria-hidden="true" data-menu>
    <nav aria-label={isCs ? 'Hlavní navigace' : 'Primary navigation'}>
      <a href="#main" data-menu-link>{isCs ? 'Domů' : 'Home'}</a>
      <a href="#work" data-menu-link>{t.nav[0]}</a>
      <a href="#services" data-menu-link>{t.nav[1]}</a>
      <a href="#about" data-menu-link>{t.nav[2]}</a>
      <a href="#contact" data-menu-link>{t.nav[3]}</a>
    </nav>
    <div class="site-menu__footer"><span>Brno, CZ</span><a href="mailto:hello@jonasrech.com">hello@jonasrech.com</a></div>
  </aside>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title" data-motion="hero">
      <img class="hero__image" src="/images/jonas-hero-figma.webp" alt="" width="2460" height="941" fetchpriority="high" decoding="async" />
      <div class="hero__shade"></div>
      <p class="hero__eyebrow" data-hero-eyebrow>{t.eyebrow}</p>
      <h1 id="hero-title">
        <span class="hero__line-mask"><span class="hero__line" data-hero-line>{t.heroA}</span></span>
        <span class="hero__line-mask accent"><span class="hero__line" data-hero-line><span>{t.heroBefore}</span><span class="hero-word">{t.heroWord}</span></span></span>
      </h1>
      <div class="hero__bottom" data-hero-bottom>
        <a class="round-link" data-magnetic href="#work"><span>{t.heroCta}</span><i class="round-link__icon" aria-hidden="true" set:html={arrowDownRightIcon}></i></a>
      </div>
    </section>

    <section class="statement section-pad" data-motion="statement">
      <p class="section-label" data-motion-label>01 — {isCs ? 'Přístup' : 'Approach'}</p>
      <div class="statement__content">
        <h2 class="statement__copy" data-motion-copy aria-label={t.workTitle}>
          {t.workTitle.split(' ').map((word, index, words) => <span data-statement-word aria-hidden="true">{word}{index < words.length - 1 ? ' ' : ''}</span>)}
        </h2>
      </div>
    </section>

    <section id="work" class="work section-pad" data-motion="work">
      <div class="section-intro section-intro--label-only">
        <p class="section-label" data-motion-label>02 — {t.workLabel}</p>
      </div>
      <div class="project-list">
        {t.projects.map((project, index) => (
          <article class="project" data-project>
            <a href={index === 0 ? `/${lang}/work/pradelna-krkonose/` : '#contact'} aria-label={`${t.projectCta}: ${project.name}`} data-project-link>
              <div class="project__reveal" data-project-reveal>
                <div class:list={['project__visual', project.class]} data-project-visual>
                  <div class="project__index">0{index + 1}</div>
                  <div class="poster-word" aria-hidden="true">{project.name}</div>
                  <div class="mock-window" aria-hidden="true"><span></span><span></span><span></span><b>{project.name}</b></div>
                </div>
              </div>
              <div class="project__meta" data-project-meta>
                <div><p>{project.type}</p><h3>{project.name}</h3></div>
                <div class="project__proof"><span>{project.status}</span><p>{project.note}</p></div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section id="services" class="services section-pad" data-motion="services">
      <div class="services__intro" data-services-intro>
        <p class="section-label" data-motion-label>03 — {t.servicesLabel}</p>
        <h2 data-motion-title>{t.servicesTitle}</h2>
        <p data-motion-support>{t.servicesIntro}</p>
      </div>
      <div class="service-list">
        {t.services.map(([number, title, text]) => (
          <article class="service" data-service tabindex="0">
            <div class="service__content" data-service-part>
              <span class="service__number">{number}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="method section-pad" data-motion="method">
      <div class="section-intro">
        <p class="section-label" data-motion-label>04 — {t.methodLabel}</p>
        <h2 data-motion-title>{t.methodTitle}</h2>
      </div>
      <ol class="method__steps">
        {t.method.map((step, index) => (
          <li data-method-step>
            <span class="method__number">0{index + 1}</span>
            <span class="method__text">{step}</span>
            <span class="method__line" aria-hidden="true"></span>
          </li>
        ))}
      </ol>
    </section>

    <section id="about" class="about section-pad" data-motion="about">
      <div class="about__image" data-about-image><img src="/images/jonas-about.webp" width="1016" height="1102" alt={isCs ? 'Jonas Rech v horách nad jezerem' : 'Jonas Rech in the mountains above a lake'} loading="lazy" decoding="async" /></div>
      <div class="about__copy" data-about-copy>
        <p class="section-label" data-motion-label>05 — {t.aboutLabel}</p>
        <h2 data-motion-title>{t.aboutTitle}</h2>
        <p data-about-detail>{t.aboutText}</p>
        <div class="about__facts" data-about-detail><span>Brno, CZ</span><span>{isCs ? 'Webdesign · Brand identity · Development' : 'Design · Code · Photo'}</span></div>
      </div>
    </section>

    <section class="photos section-pad" data-motion="photos">
      <div class="photos__heading">
        <p class="section-label" data-motion-label>06 — {t.photosLabel}</p>
        <h2 data-motion-title>{t.photosTitle}</h2>
      </div>
      <div class="photo-grid">
        <figure data-photo><img src="/images/photo-lake.webp" width="1243" height="1900" alt={isCs ? 'Horské jezero z paddleboardu' : 'Mountain lake seen from a paddleboard'} loading="lazy" decoding="async" /><figcaption>Gosausee · 2026</figcaption></figure>
        <figure data-photo><img src="/images/photo-climb.jpg" width="1536" height="2048" alt={isCs ? 'Pohled z via ferraty nad jezerem' : 'View from a via ferrata above a lake'} loading="lazy" decoding="async" /><figcaption>Austria · 2026</figcaption></figure>
        <figure data-photo><img src="/images/photo-gran-canaria.webp" width="1133" height="1700" alt={isCs ? 'Horská krajina na Gran Canarii' : 'Mountain landscape in Gran Canaria'} loading="lazy" decoding="async" /><figcaption>Gran Canaria · 2026</figcaption></figure>
      </div>
    </section>

    <section id="contact" class="contact section-pad" data-motion="contact">
      <div class="contact__ambient" aria-hidden="true"><span></span><span></span></div>
      <div class="contact__main">
        <p class="section-label" data-motion-label>07 — {t.contactLabel}</p>
        <div class="contact__message">
          <h2 data-motion-title>{t.contactTitle}</h2>
          <p class="contact__prompt" data-contact-detail>{isCs ? 'Napište mi, na čem pracujete.' : "Tell me what you're working on."}</p>
          <a class="contact__email" href="mailto:hello@jonasrech.com" data-contact-detail data-magnetic><span>{t.contactCta}</span></a>
        </div>
      </div>
      <footer class="contact__footer" data-contact-detail>
        <nav class="contact__footer-group" aria-label={isCs ? 'Navigace v patičce' : 'Footer navigation'}>
          <p>{isCs ? 'Navigace' : 'Navigation'}</p>
          <a href="#main">{isCs ? 'Domů' : 'Home'}</a>
          <a href="#work">{isCs ? 'Projekty' : 'Projects'}</a>
          <a href="#about">{t.nav[2]}</a>
          <a href="#services">{t.nav[1]}</a>
          <a href="#contact">{t.nav[3]}</a>
        </nav>
        <div class="contact__footer-group">
          <p>{isCs ? 'Sociální sítě' : 'Social'}</p>
          <a href="https://www.instagram.com/jonasrech.design" rel="me">Instagram</a>
          <a href="https://www.linkedin.com" rel="me">LinkedIn</a>
          <a href="/llm-info/">LLM info</a>
        </div>
        <div class="contact__footer-group contact__footer-info">
          <p>Jonas Rech</p>
          <span>© {new Date().getFullYear()} Jonas Rech</span>
          <span>{isCs ? 'Všechna práva vyhrazena.' : 'All rights reserved.'}</span>
        </div>
      </footer>
    </section>
  </main>

  <script>
    import gsap from 'gsap';
    import { initMotion } from '../scripts/motion';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    const setMenu = (open: boolean) => {
      document.body.classList.toggle('menu-open', open);
      if (open) header?.classList.remove('is-hidden');
      menuToggle?.classList.toggle('is-open', open);
      menuToggle?.setAttribute('aria-expanded', String(open));
      menu?.setAttribute('aria-hidden', String(!open));
      menu?.classList.toggle('is-open', open);
      if (!reduced && open) gsap.fromTo('[data-menu-link]', { opacity: 0, y: 20 }, { opacity: 1, y: 0, stagger: .055, delay: .08, duration: .55, ease: 'power3.out' });
    };
    menuToggle?.addEventListener('click', () => setMenu(!document.body.classList.contains('menu-open')));
    document.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', () => setMenu(false)));
    addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });

    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const cursor = document.querySelector<HTMLElement>('[data-cursor]');
      const cursorLabel = document.querySelector<HTMLElement>('[data-cursor-label]');
      const moveX = gsap.quickTo(cursor, 'x', { duration: .22, ease: 'power3.out' });
      const moveY = gsap.quickTo(cursor, 'y', { duration: .22, ease: 'power3.out' });
      addEventListener('pointermove', (event) => { moveX(event.clientX); moveY(event.clientY); });
      document.documentElement.classList.add('has-custom-cursor');
      document.querySelectorAll('[data-project-link]').forEach((project) => {
        project.addEventListener('pointerenter', () => { cursor?.classList.add('is-project'); if (cursorLabel) cursorLabel.textContent = 'SEE PROJECT'; });
        project.addEventListener('pointerleave', () => { cursor?.classList.remove('is-project'); if (cursorLabel) cursorLabel.textContent = ''; });
      });
      document.querySelectorAll('a, button').forEach((target) => {
        target.addEventListener('pointerenter', () => cursor?.classList.add('is-link'));
        target.addEventListener('pointerleave', () => cursor?.classList.remove('is-link'));
      });

      if (!reduced) {
        document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((element) => {
          const moveX = gsap.quickTo(element, 'x', { duration: .42, ease: 'power3.out' });
          const moveY = gsap.quickTo(element, 'y', { duration: .42, ease: 'power3.out' });
          const strength = element.classList.contains('contact__email')
            ? .14
            : element.classList.contains('round-link')
              ? .16
              : .28;
          element.addEventListener('pointermove', (event) => {
            const bounds = element.getBoundingClientRect();
            moveX((event.clientX - (bounds.left + bounds.width / 2)) * strength);
            moveY((event.clientY - (bounds.top + bounds.height / 2)) * strength);
          });
          element.addEventListener('pointerleave', () => {
            moveX(0);
            moveY(0);
          });
        });

        const contact = document.querySelector<HTMLElement>('[data-motion="contact"]');
        if (contact) {
      const followX = gsap.quickTo(contact, '--contact-follow-x', { duration: 0.8, ease: 'power3.out' }) as unknown as (value: string) => void;
      const followY = gsap.quickTo(contact, '--contact-follow-y', { duration: 0.8, ease: 'power3.out' }) as unknown as (value: string) => void;
          contact.addEventListener('pointermove', (event) => {
            const bounds = contact.getBoundingClientRect();
        const x = ((event.clientX - (bounds.left + bounds.width / 2)) / bounds.width) * 54;
        const y = ((event.clientY - (bounds.top + bounds.height / 2)) / bounds.height) * 34;
            followX(`${x.toFixed(2)}px`);
            followY(`${y.toFixed(2)}px`);
          });
          contact.addEventListener('pointerleave', () => {
            followX('0px');
            followY('0px');
          });
          contact.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
            link.addEventListener('pointerenter', () => {
              contact.classList.add('is-pulse');
            });
            link.addEventListener('pointerleave', () => {
              contact.classList.remove('is-pulse');
            });
          });
        }
      }
    }
    if (window.matchMedia('(hover: none)').matches) {
      const services = Array.from(document.querySelectorAll<HTMLElement>('[data-service]'));
      services.forEach((service) => {
        service.addEventListener('click', () => {
          const wasActive = service.classList.contains('is-active');
          services.forEach((item) => item.classList.remove('is-active'));
          service.classList.toggle('is-active', !wasActive);
        });
      });
    }
    initMotion(reduced);
    const header = document.querySelector<HTMLElement>('[data-header]');
    const hero = document.querySelector<HTMLElement>('.hero');
    if (header && hero && 'IntersectionObserver' in window) {
      const topSentinel = document.createElement('span');
      topSentinel.className = 'header-sentinel';
      topSentinel.setAttribute('aria-hidden', 'true');
      document.body.prepend(topSentinel);
      const scrollObserver = new IntersectionObserver(([entry]) => {
        header.classList.toggle('is-scrolled', !entry.isIntersecting);
      }, { rootMargin: '-20px 0px 0px 0px', threshold: 0 });
      const heroObserver = new IntersectionObserver(([entry]) => {
        header.classList.toggle('is-past-hero', !entry.isIntersecting);
      }, { rootMargin: `-${header.offsetHeight + 16}px 0px 0px 0px`, threshold: 0 });
      scrollObserver.observe(topSentinel);
      heroObserver.observe(hero);
    } else {
      header?.classList.remove('is-past-hero');
    }
  </script>
</BaseLayout>
