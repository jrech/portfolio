---
/** Homepage body, shared by `/` (cs) and `/en/` (en); copy comes from the page locale. */
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/site/SiteHeader.astro';
import SiteFooter from '@/components/site/SiteFooter.astro';
import Hero from '@/components/home/Hero.astro';
import SelectedWork from '@/components/home/SelectedWork.astro';
import Proposition from '@/components/home/Proposition.astro';
import Services from '@/components/home/Services.astro';
import Testimonial from '@/components/home/Testimonial.astro';
import About from '@/components/home/About.astro';
import Process from '@/components/home/Process.astro';
import Faq from '@/components/home/Faq.astro';
import portrait from '@/assets/images/jonas-portrait.webp';
import wanaka from '@/assets/images/about-wanaka.webp';
import marketa from '@/assets/images/marketa-blahova.webp';
import { getProjects } from '@/lib/projects';
import { getLocale, useT } from '@/i18n';

const t = useT(Astro);

// Approved for publication by the client (Jonas, 2026-10-28).
const quote = (await getProjects(getLocale(Astro))).find((p) => p.slug === 'pradelna-krkonose')?.data
  .testimonial;
---

<BaseLayout>
  <SiteHeader slot="header" overlay />
  <Hero>
    {/* Cover crop is wider than the viewport on mobile/tablet (the media keeps the photo's height). */}
    <Image
      slot="media"
      src={portrait}
      alt=""
      loading="eager"
      fetchpriority="high"
      widths={[1080, 1440, 1920, 2880]}
      sizes="(max-width: 1023px) 1080px, 70vw"
    />
  </Hero>
  <SelectedWork />
  <Proposition />
  <Services />
  {
    quote && (
      <Testimonial testimonial={quote}>
        {/* Decorative: her name is printed right beside it. */}
        <Image slot="avatar" src={marketa} alt="" widths={[48, 96, 144]} sizes="48px" />
      </Testimonial>
    )
  }
  <About>
    <Image
      slot="media"
      src={wanaka}
      alt={t.about.photoLabel}
      widths={[480, 760, 1016]}
      sizes="(min-width: 1024px) 640px, 100vw"
    />
  </About>
  <Process />
  <Faq />
  <SiteFooter slot="footer" />
</BaseLayout>
