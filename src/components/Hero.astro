---
import { translator } from '../i18n';
const t = translator(Astro.currentLocale);
import { Image } from 'astro:assets';
import CtaButton from './CtaButton.astro';
import heroVisual from '../assets/img/hero-notebook-coffee.png';
import PolygonMesh from './PolygonMesh.astro';

/* Nadpis po řádcích. `mark` = fráze s ručně kresleným fixem za textem, který se odkryje hned po vyjetí slov
   (motion.ts → hero). Bez JS a s reduced-motion je nakreslený rovnou. */
const lines: { text: string; photo?: boolean; mark?: boolean }[] =
  Astro.currentLocale === 'en'
    ? [
        { text: 'Websites that', photo: true },
        { text: 'bring small businesses' },
        { text: 'more clients.', mark: true },
      ]
    : [
        { text: 'Weby, které', photo: true },
        { text: 'malým firmám přivedou' },
        { text: 'víc zakázek.', mark: true },
      ];
const title = lines.map(({ text }) => text).join(' ');
const masked = (text: string) => text.split(' ').map((word) => ({ word }));
---

<section class="hero" aria-labelledby="hero-title">
  <PolygonMesh />
  <h1 id="hero-title" class="hero-title" aria-label={title}>
    {lines.map(({ text, photo, mark }) => (
      <span class="line" aria-hidden="true">
        {mark ? (
          <span class="hm" data-hero-mark>
            <svg class="hm-sw" viewBox="0 0 200 40" preserveAspectRatio="none" focusable="false" data-hero-swash>
              <path d="M7 13C40 6 92 10 141 7s51 2 55 9c3 8-2 17-16 18-50 3-110-1-160 2C8 37 1 30 3 22c1-4 1-6 4-9Z" />
            </svg>
            {masked(text).map(({ word }) => <span class="wm"><span class="wi">{word}</span></span>)}
          </span>
        ) : (
          text.split(' ').map((word) => <span class="wm"><span class="wi">{word}</span></span>)
        )}
        {photo && (
          <span class="pill" data-hero-pill>
            <Image
              src={heroVisual}
              alt=""
              width={168}
              height={90}
              position="center"
              densities={[1, 2]}
              loading="eager"
              fetchpriority="high"
            />
          </span>
        )}
      </span>
    ))}
  </h1>

  <div class="hero-sub" data-hero-sub>
    <p class="hero-text">
      {t('Napíšu texty, zajistím fotky a web spustím. Celou dobu jednáte přímo se mnou.', 'I write the copy, sort out the photos and launch the site. You deal with me directly the whole way.')}
    </p>
    <CtaButton />
    <p class="micro">{t('První hovor je zdarma a nezávazný.', 'The first call is free, with no obligation.')}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(56px, 8.33vw, 120px) var(--pad-x) clamp(64px, 8.9vw, 128px);
    text-align: center;
  }
  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: clamp(40px, 6.67vw, 96px);
    line-height: 1.0625;
    letter-spacing: -0.04em;
    font-weight: 500;
  }
  .line { display: block; text-wrap: balance; }
  /* maska pro „vyjetí“ slov při načtení – spodní rezerva kvůli diakritice a dotažnicím */
  .wm { display: inline-block; overflow: hidden; vertical-align: top; padding: 0.06em 0.02em 0.1em; margin: -0.06em 0.22em -0.1em -0.02em; }
  .wm:last-child { margin-right: -0.02em; }
  .wi { display: inline-block; }
  /* výchozí stav úvodní animace (jen když běží JS animace; viz Base.astro a motion.ts) */
  :global(.anim) .wi { transform: translateY(115%) rotate(4deg); }
  :global(.anim) .pill { clip-path: inset(0% 50% 0% 50% round 999px); }
  :global(.anim) .hero-sub { opacity: 0; }
  /* ručně kreslený fix za klíčovou frází (stejný princip jako citát); text zůstává v barvě písma,
     fix je jemně oranžový (kontrast textu na něm ≥ 11 : 1) */
  .hero { --hero-swash: #ffd6c4; }
  :global(:root[data-theme='dark']) .hero { --hero-swash: #5a2412; }
  .hm { position: relative; display: inline-block; isolation: isolate; white-space: nowrap; }
  .hm svg { position: absolute; overflow: visible; pointer-events: none; }
  .hm-sw { left: -0.1em; top: 0.26em; width: calc(100% + 0.2em); height: calc(100% - 0.3em); z-index: -1; }
  .hm-sw path { fill: var(--hero-swash); }
  :global(.anim) [data-hero-swash] { clip-path: inset(0 100% 0 0); }
  .pill {
    display: inline-block;
    vertical-align: -0.06em;
    width: 1.75em;
    height: 0.833em;
    border-radius: 999px;
    overflow: hidden;
    flex: none;
    background: var(--surface);
  }
  .pill :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; } /* notebook uprostřed vizuálu */

  .hero-sub {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding-top: 36px;
  }
  .hero-text {
    max-width: 711px;
    color: var(--muted);
    font-size: clamp(17px, 1.39vw, 20px);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .micro { color: var(--muted); font-size: 16px; }

  @media (max-width: 640px) {
    .hero { align-items: flex-start; text-align: left; }
    .hero-title { align-items: flex-start; }
    .hero-sub { align-items: stretch; gap: 16px; padding-top: 24px; }
    .hero-sub :global(.cta) { width: 100%; }
  }
</style>
