---
import Icon from './Icon.astro';
import { translator, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  links: Record<Locale, string>;
}

const { locale, links } = Astro.props;
const t = translator(locale);
const languages: { code: Locale; label: string; name: string }[] = [
  { code: 'cs', label: 'CZ', name: 'Čeština' },
  { code: 'en', label: 'EN', name: 'English' },
];
const toDark = t('Přepnout na tmavý režim', 'Switch to dark mode');
const toLight = t('Přepnout na světlý režim', 'Switch to light mode');
---

<div class="preferences">
  {/* přímý přepínač CZ | EN: aktuální jazyk zvýrazněný, druhý je obyčejný odkaz na stejnou stránku */}
  <nav class="lang" aria-label={t('Jazyk webu', 'Website language')}>
    {
      languages.map(({ code, label, name }) =>
        code === locale ? (
          <span class="seg is-current" aria-current="true" lang={code}>
            <span aria-hidden="true">{label}</span>
            <span class="sr-only">{name}</span>
          </span>
        ) : (
          <a class="seg" href={links[code]} lang={code} hreflang={code} data-lang-link title={name}>
            <span aria-hidden="true">{label}</span>
            <span class="sr-only">{name}</span>
          </a>
        ),
      )
    }
  </nav>
  <span class="divider" aria-hidden="true"></span>
  <button
    class="control theme"
    type="button"
    aria-pressed="false"
    aria-label={toDark}
    title={toDark}
    data-theme-toggle
    data-label-dark={toDark}
    data-label-light={toLight}
  >
    <Icon name="moon" size={17} class="i-moon" />
    <Icon name="sun" size={17} class="i-sun" />
  </button>
</div>

<script>
  import { initTheme } from '../scripts/theme';
  initTheme();

  // stejná cookie jako geo přesměrování v middleware.ts (Vercel): volba jazyka má přednost před zemí
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]')) {
    link.addEventListener('click', () => {
      document.cookie = `lang=${link.hreflang}; Path=/; Max-Age=31536000; SameSite=Lax`;
    });
  }
</script>

<style>
  .preferences {
    position: fixed;
    z-index: 55;
    right: max(12px, env(safe-area-inset-right));
    bottom: calc(12px + env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
    background: var(--ink);
    color: var(--on-dark);
    box-shadow: 0 5px 20px rgb(10 10 10 / 0.2);
  }
  .lang { display: flex; align-items: center; gap: 2px; }
  .seg {
    display: grid;
    place-items: center;
    min-width: 44px;
    height: 44px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgb(238 233 223 / 0.62);
    text-decoration: none;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .seg.is-current { background: rgb(255 255 255 / 0.17); color: var(--on-dark); }
  @media (hover: hover) {
    a.seg:hover { color: var(--on-dark); background: rgb(255 255 255 / 0.1); }
  }
  a.seg:focus-visible { outline: 2px solid var(--on-dark); outline-offset: -3px; }
  .divider { width: 1px; height: 20px; background: rgb(255 255 255 / 0.2); }
  .control {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: transparent;
  }
  .theme { color: var(--on-dark); cursor: pointer; }
  .theme :global(svg) { grid-area: 1 / 1; }
  .theme :global(.i-sun) { display: none; }
  :global(html[data-theme='dark']) .theme :global(.i-sun) { display: block; }
  :global(html[data-theme='dark']) .theme :global(.i-moon) { display: none; }
  @media (hover: hover) {
    .theme:hover { background: rgb(255 255 255 / 0.23); }
  }
  .theme:focus-visible { outline-color: var(--on-dark); outline-offset: -2px; border-radius: 50%; }
</style>
