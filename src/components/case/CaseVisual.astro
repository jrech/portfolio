---
/**
 * Large case-study visual (Pen: "Visual 01–03").
 *   full       — full-width capture: surface + rule outline
 *   responsive — desktop/mobile comparison: deep background with a mobile slot
 *   detail     — detail crop on paper
 *   screens    — one long full-page capture as three staggered columns (top, middle, end)
 *                on white (Pen 2026-11-01: "Actual website — homepage capture")
 *   mockup     — finished device mockup, plain image without a frame (Pen: "Phone mockup")
 * Until `image` is supplied the frame shows the capture brief at the approved size.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';
import Lines from '../ui/Lines.astro';
import { fitWidths } from '@/lib/projects';
import { useT } from '@/i18n';

interface Props {
  index: number;
  variant: 'full' | 'responsive' | 'detail' | 'screens' | 'mockup';
  title: string;
  /** Caption text without the number; defaults to the upper-cased title. */
  caption?: string;
  /** Mockup only: CSS object-position of the cropped image, e.g. "center 65%". */
  position?: string;
  /** Extra space below (the last visual on the page, right before Related work). */
  spaced?: boolean;
  brief: string;
  mobileLabel?: string;
  image?: { src: ImageMetadata; alt: string; mobileSrc?: ImageMetadata; mobileAlt?: string };
}

const t = useT(Astro).case;
const { index, variant, title, brief, mobileLabel = t.mobileView, image, position, spaced } = Astro.props;
const number = String(index).padStart(2, '0');
const flatTitle = (Astro.props.caption ?? title.replace(/\n/g, ' ')).toUpperCase();
const caption = image ? `/ ${flatTitle}` : `/ ${flatTitle} — ${t.captionToFollow}`;
const screenPositions = ['top', 'middle', 'end'] as const;
const isResponsive = variant === 'responsive';
---

<figure
  class:list={['visual container', `visual--${variant}`, { 'visual--filled': image, 'visual--spaced': spaced }]}
  data-reveal="fade"
>
  {
    image && variant === 'screens' ? (
      <div class="visual__frame">
        {screenPositions.map((position, i) => (
          <Image
            class={`visual__screen visual__screen--${position}`}
            src={image.src}
            alt={i === 0 ? image.alt : ''}
            widths={[400, 800]}
            sizes="(min-width: 1024px) 394px, 31vw"
            quality={100}
          />
        ))}
      </div>
    ) : image && variant === 'mockup' ? (
      <div class="visual__frame">
        <Image class="visual__image" src={image.src} alt={image.alt} widths={fitWidths([800, 1440, 2640], image.src.width)} sizes="100vw" quality={100} style={position ? { objectPosition: position } : undefined} />
      </div>
    ) : image ? (
      <div class="visual__frame">
        <Image class:list={['visual__image', { 'visual__image--paired': image.mobileSrc }]} src={image.src} alt={image.alt} widths={fitWidths([800, 1440, 2640], image.src.width)} sizes="100vw" quality={100} />
        {image.mobileSrc && <Image class="visual__image visual__image--mobile" src={image.mobileSrc} alt={image.mobileAlt ?? image.alt} widths={[390, 780]} sizes="100vw" quality={100} />}
      </div>
    ) : (
      <div class="visual__frame" role="img" aria-label={`${t.visualPlaceholderLabel} ${number}: ${title.replace(/\n/g, ' ')}`}>
        {!isResponsive && (
          <p class="visual__marker caption">
            {t.visualMarker}<span class="caption--accent">{number}</span>
          </p>
        )}
        <div class="visual__brief">
          {isResponsive && (
            <p class="visual__marker caption">
              {t.visualMarker}<span class="caption--accent">{number}</span>
            </p>
          )}
          <p class="visual__title">
            <Lines text={title} />
          </p>
          <p class="visual__description">{brief}</p>
        </div>
        {isResponsive && (
          <div class="visual__mobile">
            <p class="caption">
              <Lines text={mobileLabel.toUpperCase()} />
            </p>
            <Icon name="arrow-down" size={24} />
          </div>
        )}
      </div>
    )
  }
  {/* Finished images speak for themselves (Jonas 2026-11-04); the caption stays on placeholders. */}
  {!image && (
    <figcaption class="visual__caption caption">
      <span class="caption--accent">{number}</span>
      <span>{caption}</span>
    </figcaption>
  )}
</figure>

<style>
  /* Mobile (390) */
  .visual {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .visual--spaced {
    padding-bottom: 96px;
  }

  .visual__frame {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    overflow: hidden;
    padding: 24px;
  }

  .visual--full .visual__frame {
    height: 360px;
    background: var(--color-surface);
    outline: 1px solid var(--color-rule);
    outline-offset: -0.5px;
  }

  .visual--responsive .visual__frame {
    background: var(--color-cream-ink);
  }

  .visual--detail .visual__frame {
    height: 360px;
    background: var(--color-paper);
  }

  /* A supplied image fills the frame; the brief only belongs to the placeholder. */
  .visual--filled .visual__frame {
    padding: 0;
  }

  .visual--responsive.visual--filled .visual__frame {
    height: 560px;
  }

  .visual__frame :global(.visual__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .visual__frame :global(.visual__image--mobile) {
    display: none;
  }

  @media (max-width: 639px) {
    .visual__frame :global(.visual__image--paired) {
      display: none;
    }

    .visual__frame :global(.visual__image--mobile) {
      display: block;
    }
  }

  /* screens: three columns of one long page capture on white, scaled from the 1312 × 738 frame. */
  .visual--screens .visual__frame {
    position: relative;
    display: block;
    aspect-ratio: 1312 / 738;
    background: #fff; /* the client site's own white, not a portfolio token */
    outline: 1px solid var(--color-rule);
    outline-offset: -0.5px;
  }

  .visual--screens .visual__frame :global(.visual__screen) {
    position: absolute;
    width: 30.03%;
    height: auto;
    aspect-ratio: 394 / 876;
    object-fit: cover;
    box-shadow: 2px 8px 22px rgb(0 0 0 / 0.15);
  }

  .visual--screens .visual__frame :global(.visual__screen--top) {
    top: 7.05%;
    left: 2.59%;
    object-position: top;
  }

  .visual--screens .visual__frame :global(.visual__screen--middle) {
    top: -10.98%;
    left: 34.98%;
    object-position: center;
  }

  .visual--screens .visual__frame :global(.visual__screen--end) {
    top: -26.69%;
    left: 67.53%;
    object-position: bottom;
  }

  .visual--mockup .visual__frame {
    aspect-ratio: 4 / 3;
  }

  .visual--mockup .visual__frame :global(.visual__image) {
    object-position: center 42%;
  }

  .visual__marker {
    display: flex;
    gap: 6px;
  }

  .visual__brief {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .visual--responsive .visual__brief {
    gap: 24px;
  }

  .visual__title {
    font-size: 36px;
    font-weight: var(--weight-medium);
    line-height: normal;
    letter-spacing: -1.3px;
    color: var(--color-text-primary);
  }

  .visual__description {
    font-size: 16px;
    line-height: 24px;
    color: var(--color-text-secondary);
  }

  .visual--detail .visual__marker,
  .visual--detail .visual__title,
  .visual--detail .visual__description {
    color: var(--color-cream-ink);
  }

  .visual__mobile {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: space-between;
    width: 192px;
    height: 328px;
    padding: 24px;
    background: var(--color-surface);
    outline: 1px solid var(--color-rule);
    outline-offset: -0.5px;
    color: var(--color-text-primary);
  }

  .visual__mobile .caption {
    line-height: 15px;
  }

  /* Inline so a long caption wraps after the number instead of below it. */
  .visual__caption > :first-child {
    margin-right: 6px;
  }

  /* Tablet (interpolated) */
  @media (min-width: 640px) {
    .visual {
      gap: 24px;
    }

    .visual--spaced {
      padding-bottom: 120px;
    }

    .visual__frame {
      padding: 40px;
    }

    .visual--full .visual__frame {
      height: 520px;
    }

    .visual--detail .visual__frame {
      height: 440px;
    }

    .visual--mockup .visual__frame {
      aspect-ratio: 16 / 9;
    }

    .visual--responsive .visual__frame {
      flex-direction: row;
      align-items: flex-end;
      gap: 32px;
    }

    .visual--responsive .visual__brief {
      flex: 1 1 0;
    }

    .visual__title {
      font-size: 40px;
      letter-spacing: -1.4px;
    }

    .visual__mobile .caption {
      line-height: 17px;
    }
  }

  /* Desktop (1440) */
  @media (min-width: 1024px) {
    .visual {
      gap: 16px;
    }

    .visual--spaced {
      padding-bottom: 160px;
    }

    .visual__frame {
      gap: 0;
      padding: 48px;
    }

    .visual--full .visual__frame {
      height: 656px;
    }

    .visual--detail .visual__frame {
      height: 520px;
    }

    .visual--mockup .visual__frame {
      aspect-ratio: auto;
      height: 635px;
    }

    .visual--responsive .visual__frame {
      height: 720px;
    }

    .visual--responsive.visual--filled .visual__frame {
      height: 720px;
    }

    .visual__title {
      font-size: 48px;
      letter-spacing: var(--heading-tracking);
    }

    .visual__marker {
      gap: 7px;
    }

    .visual__caption > :first-child {
      margin-right: 7px;
    }

    .visual__mobile {
      width: 256px;
      height: 544px;
    }
  }
</style>
