---
/**
 * Large case-study visual (Pen: "Visual 01–03").
 *   full       — full-width capture: surface + rule outline
 *   responsive — desktop/mobile comparison: deep background with a mobile slot
 *   detail     — detail crop on paper
 * Until `image` is supplied the frame shows the capture brief at the approved size.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';
import Lines from '../ui/Lines.astro';

interface Props {
  index: number;
  variant: 'full' | 'responsive' | 'detail';
  title: string;
  brief: string;
  mobileLabel?: string;
  image?: { src: ImageMetadata; alt: string };
}

const { index, variant, title, brief, mobileLabel = 'Mobile\nview', image } = Astro.props;
const number = String(index).padStart(2, '0');
const flatTitle = title.replace(/\n/g, ' ').toUpperCase();
const caption = image ? `/ ${flatTitle}` : `/ ${flatTitle} — FINAL PROJECT CAPTURE TO FOLLOW`;
const isResponsive = variant === 'responsive';
---

<figure class:list={['visual container', `visual--${variant}`, { 'visual--filled': image }]}>
  {
    image ? (
      <div class="visual__frame">
        <Image class="visual__image" src={image.src} alt={image.alt} widths={[800, 1440, 2640]} sizes="100vw" />
      </div>
    ) : (
      <div class="visual__frame" role="img" aria-label={`Placeholder for visual ${number}: ${title.replace(/\n/g, ' ')}`}>
        {!isResponsive && (
          <p class="visual__marker caption">
            VISUAL /<span class="caption--accent">{number}</span>
          </p>
        )}
        <div class="visual__brief">
          {isResponsive && (
            <p class="visual__marker caption">
              VISUAL /<span class="caption--accent">{number}</span>
            </p>
          )}
          <p class="visual__title">
            <Lines text={title} />
          </p>
          <p class="visual__description">{brief}</p>
        </div>
        {isResponsive && (
          <div class="visual__mobile">
            <p class="caption">
              <Lines text={mobileLabel.toUpperCase()} />
            </p>
            <Icon name="arrow-down" size={24} />
          </div>
        )}
      </div>
    )
  }
  <figcaption class="visual__caption caption">
    <span class="caption--accent">{number}</span>
    <span>{caption}</span>
  </figcaption>
</figure>

<style>
  /* Mobile (390) */
  .visual {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .visual__frame {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    overflow: hidden;
    padding: 24px;
  }

  .visual--full .visual__frame {
    height: 360px;
    background: var(--color-surface);
    outline: 1px solid var(--color-rule);
    outline-offset: -0.5px;
  }

  .visual--responsive .visual__frame {
    background: var(--color-cream-ink);
  }

  .visual--detail .visual__frame {
    height: 360px;
    background: var(--color-paper);
  }

  /* A supplied image fills the frame; the brief only belongs to the placeholder. */
  .visual--filled .visual__frame {
    padding: 0;
  }

  .visual--responsive.visual--filled .visual__frame {
    height: 560px;
  }

  .visual__frame :global(.visual__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .visual__marker {
    display: flex;
    gap: 6px;
  }

  .visual__brief {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .visual--responsive .visual__brief {
    gap: 24px;
  }

  .visual__title {
    font-size: 36px;
    font-weight: var(--weight-medium);
    line-height: normal;
    letter-spacing: -1.3px;
    color: var(--color-text-primary);
  }

  .visual__description {
    font-size: 16px;
    line-height: 24px;
    color: var(--color-text-secondary);
  }

  .visual--detail .visual__marker,
  .visual--detail .visual__title,
  .visual--detail .visual__description {
    color: var(--color-cream-ink);
  }

  .visual__mobile {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: space-between;
    width: 192px;
    height: 328px;
    padding: 24px;
    background: var(--color-surface);
    outline: 1px solid var(--color-rule);
    outline-offset: -0.5px;
    color: var(--color-text-primary);
  }

  .visual__mobile .caption {
    line-height: 15px;
  }

  /* Inline so a long caption wraps after the number instead of below it. */
  .visual__caption > :first-child {
    margin-right: 6px;
  }

  /* Tablet (interpolated) */
  @media (min-width: 640px) {
    .visual {
      gap: 24px;
    }

    .visual__frame {
      padding: 40px;
    }

    .visual--full .visual__frame {
      height: 520px;
    }

    .visual--detail .visual__frame {
      height: 440px;
    }

    .visual--responsive .visual__frame {
      flex-direction: row;
      align-items: flex-end;
      gap: 32px;
    }

    .visual--responsive .visual__brief {
      flex: 1 1 0;
    }

    .visual__title {
      font-size: 40px;
      letter-spacing: -1.4px;
    }

    .visual__mobile .caption {
      line-height: 17px;
    }
  }

  /* Desktop (1440) */
  @media (min-width: 1024px) {
    .visual {
      gap: 16px;
    }

    .visual__frame {
      gap: 0;
      padding: 48px;
    }

    .visual--full .visual__frame {
      height: 656px;
    }

    .visual--detail .visual__frame {
      height: 520px;
    }

    .visual--responsive .visual__frame {
      height: 720px;
    }

    .visual--responsive.visual--filled .visual__frame {
      height: 720px;
    }

    .visual__title {
      font-size: 48px;
      letter-spacing: -1.5px;
    }

    .visual__marker {
      gap: 7px;
    }

    .visual__caption > :first-child {
      margin-right: 7px;
    }

    .visual__mobile {
      width: 256px;
      height: 544px;
    }
  }
</style>
