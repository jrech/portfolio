---
/** "More selected work" card: media, title + disciplines, orange arrow. Whole card is the link. */
import { Image } from 'astro:assets';
import MediaFrame from '../ui/MediaFrame.astro';
import ArrowBadge from '../ui/ArrowBadge.astro';
import WorksBadge from '../ui/WorksBadge.astro';
import { formatServices, isPublished, projectUrl, type ProjectEntry } from '@/lib/projects';
import { getLocale, useT } from '@/i18n';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { title, cardTitle, services, cover } = project.data;
/** Unpublished case studies: no link, "In the works" instead of the arrow. */
const href = isPublished(project) ? projectUrl(project, getLocale(Astro)) : undefined;
---

<article class:list={['related', { 'arrow-host': href, 'related--static': !href }]} data-reveal="fade" data-cursor={href ? 'project' : undefined}>
  <MediaFrame class="related__media" label={`${title} — ${useT(Astro).case.projectImageLabel}`}>
    {cover && <Image src={cover.src} alt={cover.alt} widths={[640, 1320]} sizes="(min-width: 1024px) 50vw, 100vw" />}
  </MediaFrame>
  <div class="related__details">
    <div class="related__text">
      <h3 class="related__title">
        {href ? <a class="related__link related__name" href={href}>{cardTitle ?? title}</a> : <span class="related__name">{cardTitle ?? title}</span>}
      </h3>
      <p class="related__disciplines">{formatServices(services)}</p>
    </div>
    {href ? <ArrowBadge /> : <WorksBadge />}
  </div>
</article>

<style>
  /* Mobile (390) */
  .related {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .related :global(.related__media) {
    height: 256px;
  }

  .related__details {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .related__text {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 6px;
  }

  .related__title {
    font-size: 24px;
    font-weight: var(--weight-medium);
    line-height: normal;
    letter-spacing: -0.8px;
    color: var(--color-text-display);
  }

  .related__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .related__link:focus-visible {
    outline: none;
  }

  .related__link:focus-visible::after {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .related__disciplines {
    font-size: 14px;
    line-height: normal;
    color: var(--color-text-secondary);
  }

  /* Tablet (interpolated) */
  @media (min-width: 640px) {
    .related :global(.related__media) {
      height: 320px;
    }
  }

  /* Desktop (1440) */
  @media (min-width: 1024px) {
    .related :global(.related__media) {
      height: 480px;
    }

    .related__details {
      gap: 24px;
    }

    .related__title {
      font-size: 28px;
    }
  }

  /* Hover: title turns accent (no underline, no image zoom). */
  .related__name {
    transition: color 350ms var(--ease-out);
  }

  .related:not(.related--static):hover .related__name,
  .related:not(.related--static):focus-within .related__name {
    color: var(--color-accent);
  }
</style>
