---
import { translator } from '../i18n';
const t = translator(Astro.currentLocale);
const en = Astro.currentLocale === 'en';

/* Věta se při scrollu „dopisuje“ (slova přechází z tlumené do plné barvy) a tři klíčová místa dostanou
   ručně kreslený fix za slovem, jedno oranžovou elipsu. Tahy jsou inline SVG uvnitř skupiny slov,
   takže se při zalamování posouvají se slovem. Bez JS a s reduced-motion je všechno nakreslené rovnou.
   Kresby jsou aria-hidden, text zůstává čistý. */
type Mark = 'swash-blue' | 'swash-mustard' | 'swash-mauve' | 'ellipse';
type Token = string | { text: string; mark: Mark };

const lines: Token[][] = en
  ? [
      ['“When someone', { text: 'recommends', mark: 'swash-blue' }, 'you,'],
      ['people often', { text: 'look you up.', mark: 'ellipse' }],
      ['A', { text: 'good website', mark: 'swash-mustard' }, 'gives them'],
      ['a reason to', { text: 'get in touch.”', mark: 'swash-mauve' }],
    ]
  : [
      ['„Když vás někdo', { text: 'doporučí,', mark: 'swash-blue' }],
      ['lidi si vás často ještě', { text: 'vygooglí.', mark: 'ellipse' }],
      [{ text: 'Dobrý web', mark: 'swash-mustard' }, 'jim ukáže,'],
      ['proč se ozvat', { text: 'právě vám.“', mark: 'swash-mauve' }],
    ];

const words = (text: string) => text.split(' ');
---

<section class="quote on-dark invert" aria-labelledby="quote-h">
  <h2 class="sr-only" id="quote-h">{t('Jak přemýšlím o webu', 'How I think about websites')}</h2>
  <blockquote class="q" data-quote>
    <p>
      {
        lines.map((line, li) => (
          <>
            {li > 0 && ' '}
            <span class="q-line">
              {line.map((token, ti) => (
                <>
                  {ti > 0 && ' '}
                  {typeof token === 'string' ? (
                    words(token).map((w, wi) => (
                      <>
                        {wi > 0 && ' '}
                        <span class="w">{w}</span>
                      </>
                    ))
                  ) : (
                    <span class:list={['mk', `mk--${token.mark}`]} data-mark>
                      {token.mark !== 'ellipse' && (
                        <svg class="sw" viewBox="0 0 200 40" preserveAspectRatio="none" aria-hidden="true" focusable="false" data-swash>
                          <path d="M7 13C40 6 92 10 141 7s51 2 55 9c3 8-2 17-16 18-50 3-110-1-160 2C8 37 1 30 3 22c1-4 1-6 4-9Z" />
                          <path class="sw-dry" d="M14 30c40-3 92 1 140-2 14-1 30-1 38-4" />
                        </svg>
                      )}
                      {words(token.text).map((w, wi) => (
                        <>
                          {wi > 0 && ' '}
                          <span class="w">{w}</span>
                        </>
                      ))}
                      {token.mark === 'ellipse' && (
                        <svg class="el" viewBox="0 0 200 80" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                          <path data-draw pathLength="1" d="M22 50C9 26 58 7 110 8c50 1 88 13 84 37-4 22-62 31-108 28C42 71 6 61 12 40 15 29 34 19 58 15" />
                        </svg>
                      )}
                    </span>
                  )}
                </>
              ))}
            </span>
          </>
        ))
      }
    </p>
  </blockquote>
</section>

<style>
  .quote {
    /* barvy fixů: tmavé tlumené tóny na tmavé kartě (bílý text na nich ≥ 6,5 : 1) */
    --sw-blue: #3c4e6b;
    --sw-mustard: #6a5a24;
    --sw-mauve: #654257;
    display: flex;
    justify-content: center;
    align-items: center;
    /* celá výška obrazovky, text na střed; svh = bez skákání mobilních lišt prohlížeče */
    min-height: 100vh;
    min-height: 100svh;
    padding: clamp(96px, 10vw, 160px) var(--pad-x);
    background: var(--ink);
    color: var(--on-dark);
  }
  /* v tmavém režimu je karta světlá: pastelové fixy, černý text na nich ≥ 13 : 1 */
  :global(:root[data-theme='dark']) .quote {
    --sw-blue: #cdd9ec;
    --sw-mustard: #efdd94;
    --sw-mauve: #ebcfdc;
  }
  .q p {
    max-width: 1100px;
    text-align: center;
    font-size: clamp(30px, 4.44vw, 64px);
    line-height: 1.16;
    letter-spacing: -0.036em;
    font-weight: 500;
  }
  .q-line { display: block; }

  /* skupina zvýrazněných slov: tahy se drží slova i při zalamování */
  .mk { position: relative; display: inline-block; isolation: isolate; white-space: nowrap; }
  .mk svg { position: absolute; overflow: visible; pointer-events: none; }

  /* fix za slovem: spodní dvě třetiny písma, lehce přesahuje do stran */
  .sw { left: -0.12em; top: 0.3em; width: calc(100% + 0.24em); height: calc(100% - 0.3em); z-index: -1; }
  .sw path { fill: var(--sw); }
  .sw .sw-dry { fill: none; stroke: var(--sw); stroke-width: 3; stroke-linecap: round; opacity: 0.6; }
  .mk--swash-blue { --sw: var(--sw-blue); }
  .mk--swash-mustard { --sw: var(--sw-mustard); }
  .mk--swash-mauve { --sw: var(--sw-mauve); }

  /* tah perem: elipsa kolem „vygooglí“ */
  .el { left: -0.3em; top: -0.1em; width: calc(100% + 0.6em); height: calc(100% + 0.22em); }
  .el path { fill: none; stroke: var(--accent); stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; }

  @media (max-width: 760px) {
    .q-line { display: inline; }
    .q p { text-align: left; text-wrap: pretty; }
  }
</style>
