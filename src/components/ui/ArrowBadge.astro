---
/** 42px orange arrow circle used on project cards; the card rotates it on hover/focus. */
import Icon from './Icon.astro';
---

<span class="arrow-badge" aria-hidden="true">
  <Icon name="arrow-up-right" size={20} />
</span>

<style>
  .arrow-badge {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-round);
    background: var(--color-accent);
    color: var(--color-ink);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .arrow-badge :global(svg) {
    stroke-width: 1.75;
  }
</style>
