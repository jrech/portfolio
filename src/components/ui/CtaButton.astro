---
/**
 * "CTA / Start a project" — reusable Pen component (GBUkS).
 * Orange pill, dark label, pale circle with arrow-up-right.
 */
import Icon from './Icon.astro';
import { useT } from '@/i18n';

interface Props {
  href: string;
  label?: string;
  /** Stretch to the container width (mobile hero). */
  block?: boolean;
  class?: string;
}

const { href, label = useT(Astro).cta.startProject, block = false, class: className } = Astro.props;
---

<a class:list={['cta', { 'cta--block': block }, className]} href={href}>
  <span class="cta__label">{label}</span>
  <span class="cta__icon" aria-hidden="true">
    <Icon name="arrow-up-right" size={20} />
  </span>
</a>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 26px;
    height: 56px;
    overflow: hidden;
    padding: 8px 8px 8px 22px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-ink);
    white-space: nowrap;
    transition: transform 100ms var(--ease-out);
  }

  /* Hover: cream floods in from the left over the orange; the circle swaps to orange. 400 ms, CSS only. */
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-cream);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 400ms var(--ease-out);
  }

  .cta:hover::before,
  .cta:focus-visible::before {
    transform: scaleX(1);
  }

  /* Mobile: every CTA spans the column with its label centred; the left padding
     mirrors the icon so the text sits in the true middle. */
  @media (max-width: 639px) {
    .cta {
      display: flex;
      width: 100%;
      padding-left: 48px;
    }

    .cta__label {
      flex: 1;
      text-align: center;
    }
  }

  .cta--block {
    display: flex;
    width: 100%;
    justify-content: space-between;
  }

  .cta__label {
    font-size: 18px;
    font-weight: var(--weight-bold);
    line-height: normal;
  }

  .cta__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-round);
    background: var(--color-text-display);
    color: var(--color-ink);
    transition: background-color 400ms var(--ease-out);
  }

  .cta:hover .cta__icon,
  .cta:focus-visible .cta__icon {
    background: var(--color-accent);
  }

  .cta__icon :global(svg) {
    stroke-width: 1.75;
    transition: transform 400ms var(--ease-out);
  }

  .cta:hover .cta__icon :global(svg),
  .cta:focus-visible .cta__icon :global(svg) {
    transform: translate(2px, -2px);
  }

  .cta:active {
    transform: scale(0.98);
  }
</style>
