---
import Eyebrow from '../ui/Eyebrow.astro';
import CtaButton from '../ui/CtaButton.astro';
import Lines from '../ui/Lines.astro';
import { getLocale, localePath, useT } from '@/i18n';

const t = useT(Astro);
const locale = getLocale(Astro);
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="about__inner container">
    <header class="about__heading">
      <Eyebrow index="[03]">{t.about.eyebrow}</Eyebrow>
      <h2 id="about-title" class="about__title" data-reveal="heading"><Lines text={t.about.title} /></h2>
    </header>

    <div class="about__story">
      <!-- Tilted photo print (export about_new.html: 640 wide, -2.651°). -->
      <div class="about__portrait" data-reveal="fade">
        <figure class="about__print">
          <div class="about__media">
            <slot name="media" />
          </div>
          <figcaption class="about__caption">{t.about.photoCaption}</figcaption>
        </figure>
      </div>

      <div class="about__intro" data-reveal="fade">
        <h3 class="about__hello">{t.about.hello}</h3>
        <p class="about__description">
          {t.about.description}
        </p>
        <p class="about__detail">
          {t.about.detail}
        </p>

        <!-- Desktop frame: CTA button. Tablet/mobile frames: text links. -->
        <CtaButton href="#contact" label={t.cta.startProject} class="about__cta" />
        <div class="about__links">
          <a class="about__link-primary" href="#contact">{t.about.linkPrimary}</a>
          <a class="about__link-secondary" href={localePath(locale, '/about')}>{t.about.linkSecondary}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Mobile (390) */
  .about__inner {
    display: flex;
    flex-direction: column;
    gap: var(--section-stack);
    padding-block: var(--section-space);
  }

  .about__heading {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .about__title {
    font-size: 40px;
    font-weight: var(--weight-medium);
    line-height: 41px;
    letter-spacing: var(--heading-tracking);
    color: var(--color-text-primary);
  }

  .about__story {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .about__portrait {
    position: relative;
    flex-shrink: 0;
  }

  /* Room for the tilt, so the corners never touch the gutter. */
  .about__portrait {
    padding: 12px 6px;
  }

  .about__print {
    padding: 8px;
    background: var(--color-paper);
    transform: rotate(-2.651deg);
  }

  .about__media {
    aspect-ratio: 620 / 500;
    overflow: hidden;
    background: var(--color-surface);
  }

  /* Export crop: the photo covers the frame, shifted slightly below centre. */
  .about__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 56%;
  }

  .about__caption {
    padding: 12px 4px 6px;
    font-size: 14px;
    font-style: italic;
    line-height: normal;
    color: var(--color-cream-ink);
  }

  .about__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Hierarchy, not one even gap: heading, then the two paragraphs as one group,
     then the action set further apart (Jonas, 2026-10-29). */
  .about__description {
    margin-top: 24px;
  }

  .about__detail {
    margin-top: 12px;
  }

  .about__intro :global(.about__cta),
  .about__link-primary {
    margin-top: 40px;
  }

  .about__hello {
    font-size: 24px;
    font-weight: var(--weight-medium);
    line-height: normal;
    letter-spacing: -0.6px;
    color: var(--color-text-primary);
  }

  .about__description,
  .about__detail {
    text-wrap: pretty;
  }

  .about__description {
    font-size: 17px;
    line-height: 26px;
    color: var(--color-text-lead);
  }

  .about__detail {
    font-size: 16px;
    line-height: 24px;
    color: var(--color-text-secondary);
  }

  .about__intro :global(.about__cta) {
    display: none;
  }

  .about__links {
    display: contents;
  }

  .about__link-primary {
    font-size: 18px;
    font-weight: var(--weight-medium);
    line-height: normal;
    color: var(--color-accent);
  }

  .about__link-secondary {
    margin-top: 16px;
    font-size: 14px;
    line-height: normal;
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* Phones keep just the main link (Jonas, 2026-10-30). */
  @media (max-width: 639px) {
    .about__link-secondary {
      display: none;
    }
  }

  .about__link-primary:hover,
  .about__link-primary:focus-visible,
  .about__link-secondary:hover,
  .about__link-secondary:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .about__link-secondary:hover {
    color: var(--color-text-primary);
  }


  /* Tablet (834) */
  @media (min-width: 640px) {

    .about__title {
      font-size: 56px;
      line-height: 57px;
      letter-spacing: var(--heading-tracking);
    }

    .about__story {
      flex-direction: row;
      align-items: center;
    }

    .about__portrait {
      width: 46%;
      padding: 16px 8px;
    }

    .about__print {
      padding: 10px;
    }

    .about__caption {
      padding: 14px 4px 8px;
      font-size: 15px;
    }

    .about__intro {
      flex: 1;
    }

    .about__hello {
      font-size: 28px;
    }

    .about__link-primary {
      font-size: 19px;
    }

    .about__link-secondary {
      font-size: 15px;
    }
  }

  /* Desktop (1440) */
  @media (min-width: 1024px) {

    .about__title {
      font-size: 76px;
      line-height: 78px;
      letter-spacing: var(--heading-tracking);
    }

    .about__story {
      gap: 100px;
    }

    /* 640px print at 1440 (665 with the tilt); shrinks first on narrower desktops
       so the copy keeps ≥ 360px. */
    .about__portrait {
      flex: 0 1 665px;
      width: auto;
      min-width: 0;
      padding: 16px 12px;
    }

    .about__intro {
      flex: 0 1 530px;
      min-width: 360px;
    }

    .about__hello {
      font-size: 36px;
      letter-spacing: -1.1px;
    }

    /* Export: one even 26px gap down the column. */
    .about__description {
      margin-top: 26px;
      font-size: 19px;
      line-height: 29px;
    }

    .about__detail {
      margin-top: 26px;
      max-width: 388px;
      font-size: 17px;
      line-height: 26px;
    }

    .about__intro :global(.about__cta) {
      display: inline-flex;
      margin-top: 26px;
    }

    .about__links {
      display: none;
    }
  }
</style>
