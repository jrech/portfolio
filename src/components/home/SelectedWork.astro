---
import Eyebrow from '../ui/Eyebrow.astro';
import ProjectCard from './ProjectCard.astro';
import { getProjects } from '@/lib/projects';
import { getLocale, useT } from '@/i18n';

const t = useT(Astro);
const projects = await getProjects(getLocale(Astro));
---

<section id="work" class="work theme-deep" aria-labelledby="work-title">
  <div class="work__inner container">
    <header class="work__heading">
      <div class="work__title-group">
        <Eyebrow index="[01]">{t.work.eyebrow}</Eyebrow>
        <h2 id="work-title" class="work__title" data-reveal="heading">{t.work.title}</h2>
      </div>
      <p class="caption">{t.work.years}</p>
    </header>

    <div class="work__grid">
      {projects.map((project, i) => <ProjectCard project={project} featured={i === 0} />)}
    </div>
  </div>
</section>

<style>
  /* Mobile (390) */
  .work__inner {
    display: flex;
    flex-direction: column;
    gap: var(--section-stack);
    padding-block: var(--section-space);
  }

  .work__heading {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .work__title-group {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .work__title {
    font-size: 36px;
    font-weight: var(--weight-medium);
    line-height: normal;
    letter-spacing: var(--heading-tracking);
    color: var(--color-text-display);
  }

  .work__grid {
    display: grid;
    gap: 56px;
  }

  /* Tablet (834) */
  @media (min-width: 640px) {

    .work__title {
      font-size: 48px;
    }

    .work__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 72px 24px;
    }
  }

  /* Desktop (1440) */
  @media (min-width: 1024px) {

    .work__heading {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .work__title-group {
      gap: 16px;
    }

    .work__title {
      font-size: 54px;
      letter-spacing: var(--heading-tracking);
    }

    .work__grid {
      gap: 80px 28px;
    }
  }
</style>
