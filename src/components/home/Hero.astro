---
/**
 * Homepage hero (Pen: "2C. Editorial Field Notes — Expressive type", export hero_new.html).
 * Expressive two-line headline with an accent italic word, a tilted photo print on the
 * right, and a ruled bar with the disciplines at the bottom.
 * The photo goes into the `media` slot; without it the print keeps a neutral surface.
 */
import CtaButton from '../ui/CtaButton.astro';
import Icon from '../ui/Icon.astro';
import Lines from '../ui/Lines.astro';
import { useT } from '@/i18n';

const t = useT(Astro);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__meta" data-reveal="fade">
      <p class="hero__kicker">{t.hero.kicker}</p>
      <p class="hero__location">{t.hero.location}</p>
    </div>

    <div class="hero__body">
      <div class="hero__message">
        <h1 id="hero-title" class="hero__title" data-reveal="heading">
          <Lines text={t.hero.title} /> <em class="hero__accent">{t.hero.titleAccent}</em>
        </h1>
        <div class="hero__lead">
          <p class="hero__intro" data-reveal="fade">
            {t.hero.intro}
          </p>
          <div class="hero__actions" data-reveal="fade">
            <CtaButton href="#contact" label={t.cta.startProject} class="hero__cta" />
          </div>
        </div>
      </div>

      <!-- `.hero__media` is the first-visit intro target in motion.ts. -->
      <figure class="hero__media hero__print">
        <div class="hero__photo">
          <slot name="media" />
        </div>
        <figcaption class="hero__caption">{t.hero.photoCaption}</figcaption>
      </figure>
    </div>

    <div class="hero__bar" data-reveal="fade">
      <p class="hero__disciplines">{t.hero.disciplines}</p>
      <a class="hero__explore" href="#work">
        <span>{t.hero.explore}</span>
        <Icon name="arrow-down" size={20} />
      </a>
    </div>
  </div>
</section>

<style>
  /* Mobile (390) — the export is desktop-only; small screens stack the same parts:
     meta, headline, intro, CTA, the print, then the disciplines bar. */
  .hero {
    position: relative;
    background: var(--color-background);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--header-height) + 24px);
    padding-bottom: 32px;
  }

  .hero__meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hero__kicker,
  .hero__location {
    font-family: var(--font-caption);
    font-size: var(--caption-size);
    font-weight: var(--weight-regular);
    letter-spacing: 0.8px;
    line-height: normal;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .hero__body {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: 48px 64px;
  }

  .hero__message {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  /* Export: 132/135, tracking -6.2px at 1440 (≈ -0.047em), scaled with the viewport. */
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(44px, 13.2vw, 132px);
    font-weight: var(--weight-medium);
    line-height: 1.02;
    letter-spacing: -0.047em;
    color: var(--color-text-primary);
  }

  .hero__accent {
    font-style: italic;
    color: var(--color-accent);
    /* Italic overhang would touch the edge of the line box. */
    padding-right: 0.04em;
  }

  .hero__lead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    width: 100%;
  }

  .hero__intro {
    max-width: 570px;
    font-size: 17px;
    line-height: 1.5;
    letter-spacing: -0.15px;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    width: 100%;
    padding-top: 4px;
  }

  .hero__actions :global(.hero__cta) {
    width: 100%;
    justify-content: space-between;
  }

  /* The print: paper border, photo, handwritten-style italic caption. */
  .hero__print {
    align-self: center;
    width: min(76%, 300px);
    padding: 10px;
    background: var(--color-paper);
    transform: rotate(4deg);
  }

  /* First-visit intro start state; motion.ts takes over from here. */
  :global(html.intro) .hero__media {
    opacity: 0;
  }

  .hero__photo {
    aspect-ratio: 330 / 408;
    overflow: hidden;
    background: var(--color-surface);
  }

  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__caption {
    padding: 14px 4px 8px;
    font-size: 15px;
    font-style: italic;
    line-height: normal;
    color: var(--color-cream-ink);
  }

  .hero__bar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding-top: 22px;
    border-top: 1px solid var(--color-rule);
  }

  .hero__disciplines {
    font-size: 15px;
    line-height: normal;
    color: var(--color-text-primary);
  }

  .hero__explore {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-caption);
    font-size: var(--caption-size);
    font-weight: var(--weight-regular);
    letter-spacing: 1px;
    line-height: normal;
    text-transform: uppercase;
    color: var(--color-text-primary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .hero__explore :global(svg) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .hero__explore:hover,
  .hero__explore:focus-visible {
    color: var(--color-accent);
  }

  .hero__explore:hover :global(svg),
  .hero__explore:focus-visible :global(svg) {
    transform: translateY(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__explore :global(svg) {
      transition: none;
    }
  }

  /* Tablet (768–1023): headline across the full width, intro + CTA beside the print. */
  @media (min-width: 640px) {
    .hero__inner {
      padding-top: calc(var(--header-height) + 40px);
      padding-bottom: 40px;
    }

    .hero__meta {
      flex-direction: row;
      justify-content: space-between;
      gap: 24px;
    }

    .hero__body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto auto;
      column-gap: 40px;
      padding-block: 64px 72px;
    }

    .hero__message {
      display: contents;
    }

    .hero__title {
      grid-column: 1 / -1;
      grid-row: 1;
      font-size: min(12.4vw, 132px);
      margin-bottom: 48px;
    }

    .hero__lead {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
      gap: 36px;
    }

    .hero__intro {
      font-size: 18px;
      line-height: 27px;
    }

    .hero__actions {
      width: auto;
      padding: 0;
    }

    .hero__actions :global(.hero__cta) {
      width: auto;
    }

    .hero__print {
      grid-column: 2;
      grid-row: 2;
      align-self: start;
      width: 250px;
      /* Tucks up under the headline so the lead and the print read as one row. */
      margin-top: -16px;
      margin-right: 8px;
    }

    .hero__bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  /* Desktop (1440 frame, 980 tall): fills the viewport; message left, print right,
     both centred between the meta line and the bar. */
  @media (min-width: 1024px) {
    .hero__inner {
      min-height: 100vh;
      min-height: 100svh;
      /* Header 96 + 59 = the export's meta line at 155. */
      padding-top: calc(var(--header-height) + 59px);
      padding-bottom: 60px;
    }

    .hero__body {
      flex: 1;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto;
      align-items: center;
      column-gap: 48px;
      padding-block: 56px 88px;
    }

    .hero__message {
      grid-column: 1;
      grid-row: 1;
      display: flex;
      gap: 40px;
    }

    .hero__title {
      font-size: min(9.17vw, 132px);
      line-height: 1.023; /* 135 / 132 */
      margin-bottom: 0;
    }

    .hero__lead {
      gap: 40px;
    }

    /* 350 at 1440, scales down with the headline on narrower desktops. */
    .hero__print {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      width: min(24.3vw, 350px);
      margin-right: 32px;
    }
  }
</style>
