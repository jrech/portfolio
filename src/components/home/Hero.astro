---
/**
 * Homepage hero (Pen: "Portrait-led hero").
 * Portrait goes into the `media` slot (Pen fill: images/jonasrech.com/fecb2159341c8134.webp, cover).
 * Without it the frame stays a neutral surface.
 */
import CtaButton from '../ui/CtaButton.astro';
import { site } from '@/data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <slot name="media" />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__inner container">
    <div class="hero__message">
      <h1 id="hero-title" class="hero__title">
        Distinctive websites that help businesses win more enquiries.
      </h1>
      <p class="hero__intro">
        I design and build strategic websites that make your business stand out and earn trust.
      </p>
      <div class="hero__actions">
        <CtaButton href="#contact" class="hero__cta" />
        <a class="hero__explore" href="#work">Explore the work ↓</a>
      </div>
    </div>

    <p class="hero__baseline caption">{site.location.toUpperCase()}</p>
  </div>
</section>

<style>
  /* Mobile (390 frame) */
  /* Full viewport (Jonas, 2026-10-28). svh keeps mobile browser bars from cropping it;
     the message is placed relative to the edges so the Pen positions hold at frame height. */
  .hero {
    position: relative;
    isolation: isolate;
    height: 100vh;
    height: 100svh;
    min-height: 620px;
    overflow: hidden;
    background: var(--color-background);
  }

  .hero__media {
    position: absolute;
    inset: 0 0 auto;
    z-index: -2;
    height: 62.65%; /* 520 / 830 */
    background: var(--color-surface);
  }

  .hero__media :global(img),
  .hero__media :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Mobile frame: cover crop shifted right (export: translateX -824.55 of 969.5 → 85%). */
    object-position: 85% center;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      0deg,
      var(--color-background) 0%,
      #10100fee 42%,
      #10100f00 85%
    );
  }

  /* Mobile: message sits above the baseline (bottom 197 at the 830 frame). */
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    padding-bottom: clamp(96px, 23.7vh, 197px);
  }

  .hero__message {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: var(--weight-medium);
    line-height: 0.98;
    letter-spacing: -1.5px;
    color: var(--color-text-display);
  }

  .hero__intro {
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text-intro);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
  }

  .hero__actions :global(.hero__cta) {
    width: 100%;
    justify-content: space-between;
  }

  .hero__explore {
    font-family: var(--font-caption);
    font-size: var(--caption-size);
    font-weight: var(--weight-bold);
    letter-spacing: var(--caption-tracking);
    line-height: normal;
    color: var(--color-paper);
    white-space: nowrap;
    text-underline-offset: 4px;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .hero__explore:hover,
  .hero__explore:focus-visible {
    color: var(--color-text-display);
    text-decoration: underline;
  }

  .hero__baseline {
    position: absolute;
    bottom: 25px;
  }

  /* Tablet (834 frame) */
  @media (min-width: 640px) {
    .hero {
      min-height: 560px;
    }

    /* Centred between header and baseline; paddings reproduce the frame's 270px top at 800. */
    .hero__inner {
      justify-content: center;
      padding-top: var(--header-height);
      padding-bottom: 35px;
    }

    .hero__media {
      height: 100%;
    }

    /* Tablet and desktop frames use a plain centred cover. */
    .hero__media :global(img) {
      object-position: center;
    }

    .hero__shade {
      background: linear-gradient(
        -90deg,
        #10100f00 0%,
        #10100fcc 70%,
        var(--color-background) 100%
      );
    }

    .hero__message {
      max-width: 640px;
    }

    .hero__title {
      max-width: 538px;
      font-size: 52px;
      letter-spacing: -2.5px;
    }

    .hero__actions {
      flex-direction: row;
      width: auto;
    }

    .hero__actions :global(.hero__cta) {
      width: auto;
    }

    .hero__baseline {
      bottom: 32px;
    }
  }

  /* Desktop (1440 frame) */
  @media (min-width: 1024px) {
    .hero {
      min-height: 600px;
    }

    /* Reproduces the frame's 229px top at 816. */
    .hero__inner {
      padding-bottom: 141px;
    }

    .hero__message {
      max-width: 860px;
      gap: 30px;
    }

    .hero__title {
      max-width: 843px;
      font-size: 66px;
      letter-spacing: -3.5px;
    }

    .hero__intro {
      max-width: 446px;
      font-size: 17px;
      line-height: 26px;
    }

    .hero__actions {
      gap: 30px;
      padding-top: 16px;
    }

    /* Desktop frame sets the anchor in Rethink Sans, not Space Mono. */
    .hero__explore {
      font-family: var(--font-display);
      font-size: 11px;
      letter-spacing: normal;
    }

    .hero__baseline {
      bottom: 53px;
    }
  }
</style>
