---
/**
 * "A clear reason to choose you" — single editorial statement, a full-viewport section.
 * The sticky stage reserves its scroll distance before JS loads; motion.ts
 * lights the words up one by one as the visitor scrolls.
 */
import { useT } from '@/i18n';

const t = useT(Astro);
---

<section class="proposition" aria-label={t.a11y.propositionLabel}>
  <div class="proposition__inner container">
    <p class="proposition__text" data-reveal="scrub">
      {t.proposition.text}
    </p>
  </div>
</section>

<style>
  /* Mobile (390) */
  .proposition {
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
  }

  .proposition__inner {
    display: flex;
    justify-content: center;
    padding-block: 64px;
  }

  /* Reserve the extra scroll distance in the first layout. GSAP's dynamic pin
     spacer used to shift restored scroll positions by an entire viewport. */
  :global(html.js-motion) .proposition {
    display: block;
    min-height: 200vh;
    min-height: 200svh;
  }

  :global(html.js-motion) .proposition__inner {
    position: sticky;
    top: 0;
    min-height: 100vh;
    min-height: 100svh;
    align-items: center;
  }

  .proposition__text {
    font-size: 38px;
    font-weight: var(--weight-medium);
    line-height: 42px;
    letter-spacing: var(--heading-tracking);
    color: var(--color-text-primary);
  }

  /* Tablet (834) */
  @media (min-width: 640px) {
    .proposition__inner {
      padding-block: 80px;
    }

    .proposition__text {
      font-size: 54px;
      line-height: 59px;
      letter-spacing: var(--heading-tracking);
    }
  }

  /* Desktop (1440) */
  @media (min-width: 1024px) {
    .proposition__inner {
      padding-block: 96px;
    }

    .proposition__text {
      max-width: 1130px;
      font-size: 72px;
      line-height: 76px;
      letter-spacing: var(--heading-tracking);
    }
  }
</style>
