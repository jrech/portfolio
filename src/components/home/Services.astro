---
import Eyebrow from '../ui/Eyebrow.astro';
import Lines from '../ui/Lines.astro';
import { useT } from '@/i18n';

const t = useT(Astro);
const services = t.services.items;
---

<section id="services" class="services theme-cream" aria-labelledby="services-title">
  <div class="services__inner container">
    <header class="services__intro">
      <div class="services__headline">
        <Eyebrow index="[02]">{t.services.eyebrow}</Eyebrow>
        <h2 id="services-title" class="services__title" data-reveal="heading"><Lines text={t.services.title} /></h2>
      </div>
      <p class="services__lead" data-reveal="fade"><Lines text={t.services.lead} /></p>
    </header>

    <ol class="services__list" role="list">
      {
        services.map((service, i) => (
          <li class="service" data-reveal="fade">
            <span class="service__index caption caption--accent" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="service__name">{service.name}</h3>
            <p class="service__description service__description--short">{service.shortDescription}</p>
            <p class="service__description service__description--full">{service.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Mobile (390) */
  .services__inner {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-block: 64px;
  }

  .services__intro,
  .services__headline {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .services__title {
    font-size: 40px;
    font-weight: var(--weight-medium);
    line-height: 41px;
    letter-spacing: -1.6px;
  }

  .services__lead {
    font-size: 16px;
    line-height: 24px;
    color: var(--color-text-secondary);
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-block: 24px;
    border-top: 1px solid var(--color-rule);
  }

  /* Index is hidden in the mobile frame. */
  .service__index {
    display: none;
  }

  .service__name {
    font-size: 25px;
    font-weight: var(--weight-medium);
    line-height: 28px;
    letter-spacing: -0.6px;
  }

  .service__description {
    font-size: 16px;
    line-height: 24px;
    color: var(--color-text-secondary);
  }

  /* Tablet/mobile frames use shorter copy than desktop. */
  .service__description--full {
    display: none;
  }

  /* Tablet (834) */
  @media (min-width: 640px) {
    .services__inner {
      gap: 44px;
      padding-block: 80px;
    }

    .services__title {
      font-size: 52px;
      line-height: 53px;
      letter-spacing: -2px;
    }

    .service {
      flex-direction: row;
      align-items: center;
      gap: 24px;
    }

    .service__index {
      display: block;
      flex: 0 0 28px;
    }

    .service__name {
      flex: 1;
      font-size: 27px;
      line-height: 30px;
    }

    .service__description {
      flex: 0 0 285px;
    }
  }

  /* Desktop (1440) */
  @media (min-width: 1024px) {
    .services__inner {
      gap: 64px;
      padding-block: 120px;
    }

    .services__headline {
      max-width: 640px;
      gap: 28px;
    }

    .services__title {
      font-size: 68px;
      line-height: 69px;
      letter-spacing: -3px;
    }

    .services__lead {
      display: none;
    }

    .service {
      justify-content: space-between;
      gap: 30px;
      padding-block: 28px;
    }

    .service__index {
      flex-basis: 40px;
    }

    .service__name {
      flex: 0 1 480px;
      font-size: 34px;
      line-height: 38px;
      letter-spacing: -1px;
    }

    .service__description {
      flex: 0 1 430px;
      font-size: 15px;
      line-height: 22px;
      text-align: right;
    }

    .service__description--short {
      display: none;
    }

    .service__description--full {
      display: block;
    }
  }
</style>
