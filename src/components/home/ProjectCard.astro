---
/**
 * Selected-work panel (Pen "Vybrané práce / rozbalovací galerie", Jonas 2026-11-18).
 * One panel is open at a time: full-bleed cover, title, description, disciplines and
 * the arrow badge. Closed panels show only the title, status and a plus. SelectedWork
 * switches the open panel on hover (fine pointer, desktop), focus or tap.
 *
 * Both layers are always in the DOM: the closed "peek" is visual only, the open
 * details carry the heading, copy and link, so assistive tech reads every project.
 */
import { Image } from 'astro:assets';
import MediaFrame from '../ui/MediaFrame.astro';
import ArrowBadge from '../ui/ArrowBadge.astro';
import Icon from '../ui/Icon.astro';
import { fitWidths, isPublished, projectUrl, type ProjectEntry } from '@/lib/projects';
import { getLocale, useT } from '@/i18n';

interface Props {
  project: ProjectEntry;
  index: number;
  open?: boolean;
}

const { project, index, open = false } = Astro.props;
const t = useT(Astro);
const { title, description, services, cover } = project.data;
const href = isPublished(project) ? projectUrl(project, getLocale(Astro)) : undefined;
const status = href ? t.work.caseStudy : t.case.inTheWorks;
const detailsId = `work-panel-${project.slug}`;
const words = title.split(/\s+/);
---

<article
  class:list={['panel', { 'is-open': open, 'arrow-host': href, 'panel--static': !href }]}
  data-panel={index}
  data-reveal="fade"
  data-cursor={href ? 'project' : undefined}
>
  <MediaFrame class="panel__media project__media">
    {
      cover && (
        <Image
          src={cover.src}
          alt={cover.alt}
          widths={fitWidths([640, 960, 1320, 2640], cover.src.width)}
          sizes="(min-width: 1440px) 680px, (min-width: 1024px) 50vw, 100vw"
          quality={100}
          loading={index === 0 ? 'eager' : 'lazy'}
          style={cover.position ? { objectPosition: cover.position } : undefined}
        />
      )
    }
    {/* Whole open panel is the link; the title link stays the one keyboard/AT stop. */}
    {href && <a class="panel__cover" href={href} tabindex="-1" aria-hidden="true" />}
  </MediaFrame>
  <span class="panel__shade" aria-hidden="true"></span>

  <button class="panel__toggle" type="button" aria-expanded={open ? 'true' : 'false'} aria-controls={detailsId}>
    <span class="visually-hidden">{t.work.expand}: {title}</span>
  </button>

  <div class="panel__peek" aria-hidden="true">
    <p class="panel__peek-title">{words.map((word) => <span>{word} </span>)}</p>
    <div class="panel__row">
      <span class="caption panel__status">{status}</span>
      <Icon name="plus" size={16} class="panel__plus" />
    </div>
  </div>

  <div class="panel__details" id={detailsId}>
    <div class="panel__text">
      <div class="panel__head">
        <h3 class="panel__title">
          {href ? <a class="panel__link panel__name" href={href}>{title}</a> : <span class="panel__name">{title}</span>}
        </h3>
        {href && <ArrowBadge />}
      </div>
      <p class="panel__description">{description}</p>
    </div>
    <div class="panel__row panel__row--meta">
      <p class="caption panel__disciplines">{services.join(' / ')}</p>
      {!href && <span class="caption panel__status">{status}</span>}
    </div>
  </div>
</article>

<style>
  /* Shared by both layouts: everything sits on the cover, bottom aligned. */
  .panel {
    position: relative;
    overflow: hidden;
    min-width: 0;
    background: var(--color-surface);
    color: var(--color-text-display);
  }

  .panel :global(.panel__media) {
    position: absolute;
    inset: 0;
  }

  .panel__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, #10100f00 30%, #10100fb3 62%, #10100ff7 100%);
  }

  /* Stacked layout only: closed strips are short, so the title needs a darker veil. */
  .panel__shade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #10100fe0 0%, #10100fa6 100%);
    transition: opacity 500ms var(--ease-out);
  }

  .panel.is-open .panel__shade::after {
    opacity: 0;
  }

  @media (min-width: 1024px) {
    .panel__shade::after {
      display: none;
    }
  }

  /* Closed panels: the whole panel is the toggle. Open: it steps aside for the link. */
  .panel__toggle {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .panel__toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .panel.is-open .panel__toggle {
    pointer-events: none;
  }

  .panel__peek,
  .panel__details {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  .panel__peek {
    right: 0;
    gap: 14px;
    padding: 0 16px 18px;
    transition: opacity 260ms var(--ease-out);
  }

  .panel.is-open .panel__peek {
    opacity: 0;
  }

  .panel__peek-title {
    font-size: 26px;
    font-weight: var(--weight-medium);
    line-height: 1.04;
    letter-spacing: -1px;
  }

  .panel__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid #f2efe940;
  }

  .panel__status {
    color: var(--color-text-intro);
    white-space: nowrap;
  }

  .panel :global(.panel__plus) {
    flex-shrink: 0;
    color: var(--color-text-display);
    stroke-width: 1.5;
  }

  /* Open details are laid out at the open width all the time, so the copy never
     re-wraps while the panel grows; they only fade and lift in. */
  .panel__details {
    z-index: 2;
    width: 100%;
    gap: 16px;
    padding: 0 16px 18px;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 220ms var(--ease-out),
      transform 220ms var(--ease-out);
  }

  .panel.is-open .panel__details {
    opacity: 1;
    transform: none;
    transition:
      opacity 500ms var(--ease-out) 260ms,
      transform 700ms var(--ease-out) 260ms;
  }

  .panel.is-open .panel__details > * {
    pointer-events: auto;
  }

  .panel__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .panel__title {
    font-size: 30px;
    font-weight: var(--weight-medium);
    line-height: 1.09;
    letter-spacing: -1px;
  }

  .panel__cover {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .panel.is-open .panel__cover {
    pointer-events: auto;
  }

  .panel__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .panel__name {
    transition: color 350ms var(--ease-out);
  }

  .panel:not(.panel--static).is-open:hover .panel__name,
  .panel:not(.panel--static):focus-within .panel__name {
    color: var(--color-accent);
  }

  .panel__description {
    max-width: 470px;
    font-size: 15px;
    line-height: 21px;
    color: var(--color-paper);
  }

  .panel__disciplines {
    color: var(--color-text-intro);
  }

  /* Mobile + tablet: a vertical accordion of full-width strips. */
  .panel {
    height: 104px;
    transition: height 700ms var(--ease-out);
  }

  .panel.is-open {
    height: 440px;
  }

  .panel__peek-title {
    font-size: 24px;
  }

  @media (min-width: 640px) {
    .panel {
      height: 120px;
    }

    .panel.is-open {
      height: 500px;
    }

    .panel__peek-title {
      font-size: 28px;
    }

    .panel__peek,
    .panel__details {
      padding: 0 24px 22px;
    }

    .panel__title {
      font-size: 40px;
      letter-spacing: -1.4px;
    }

    .panel__description {
      font-size: 16px;
      line-height: 22px;
    }
  }

  /* Desktop: side-by-side panels; the open one takes about half the row. */
  @media (min-width: 1024px) {
    .panel {
      flex: 1 1 0;
      height: auto;
      transition: flex-grow 750ms var(--ease-out);
    }

    .panel.is-open {
      flex-grow: var(--open-grow);
      height: auto;
    }

    .panel__peek-title span {
      display: block;
    }

    .panel__peek {
      padding: 0 16px 18px;
      container-type: inline-size;
    }

    .panel__peek-title {
      /* "Starobrněnský" is the longest word; it has to fit the narrow panel. */
      font-size: min(30px, 100cqi / 6.4);
    }

    .panel__details {
      /* The open panel's width (see SelectedWork): its share of the row without the gaps. */
      width: calc(
        (100cqw - (var(--panel-count) - 1) * var(--panel-gap)) * var(--open-grow) /
          (var(--open-grow) + var(--panel-count) - 1)
      );
      padding: 0 24px 22px;
    }

    .panel__title {
      font-size: clamp(36px, 3.1vw, 44px);
      letter-spacing: -1.6px;
    }

    .panel__head :global(.arrow-badge) {
      width: 46px;
      height: 46px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel,
    .panel__shade::after,
    .panel__peek,
    .panel__details,
    .panel.is-open .panel__details {
      transition: none;
    }

    .panel__details {
      transform: none;
    }
  }
</style>
