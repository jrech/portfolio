---
import { translator } from '../i18n';
const t = translator(Astro.currentLocale);
import Icon from './Icon.astro';

const faqs = [
  { q: t('Kolik stojí web na míru?', 'How much does a custom website cost?'), a: t('Cena záleží na rozsahu webu, textech a focení. Po úvodním hovoru vám pošlu pevnou cenu za domluvený rozsah.', 'It depends on the size of the website, the copy and the photography. After our first call, I’ll send you a fixed price for the agreed scope.') },
  { q: t('Jak dlouho trvá tvorba webu?', 'How long does it take to build a website?'), a: t('U menšího webu počítejte zhruba se 3–4 týdny od schválení nabídky. Termín si domluvíme předem podle rozsahu a focení.', 'Allow around three to four weeks for a smaller website once you approve the quote. We’ll agree on a timeline based on the scope and photography.') },
  { q: t('Kolik času mi to zabere?', 'How much of my time will it take?'), a: t('Zhruba tři hodiny. Na úvod si zavoláme, podle potřeby se potkáme na focení a pak mi řeknete, co upravit v textech a návrhu.', 'Around three hours. We’ll start with a call, meet for photos if needed, and then you’ll give me feedback on the copy and design.') },
  { q: t('Už web mám. Potřebuju nový?', 'I already have a website. Do I need a new one?'), a: t('Ne nutně. Na hovoru probereme, co nefunguje. Když stačí upravit pár stránek, řeknu vám to.', 'We’ll talk through what’s going wrong, and I’ll tell you if updating a few pages would do the job.') },
  { q: t('Komu patří doména a web?', 'Who owns the domain and website?'), a: t('Vám. Doména i hosting jsou na vaše jméno a při předání dostanete všechny přístupy.', 'You do. The domain and hosting will be in your name, and I’ll give you all your login details at handover.') },
  { q: t('Co když budu chtít později něco změnit?', 'What if I need to change something later?'), a: t('Drobné úpravy v prvním měsíci jsou v ceně. Později je můžu udělat za hodinovou sazbu, bez paušálu.', 'Small changes in the first month are included. After that, I can make updates at an hourly rate with no retainer.') },
];
---

<section class="faq" id="otazky" aria-labelledby="faq-h">
  <div class="intro">
    <h2 class="title" id="faq-h" data-reveal>{t('Na co se', 'Frequently asked')}<br />{t('mě ptáte', 'questions')}</h2>
    <div class="more" data-reveal>
      <p>{t('Máte jinou otázku?', 'Have another question?')}</p>
      <a class="mail" href="mailto:hello@jonasrech.com">hello@jonasrech.com <Icon name="arrow-up-right" size={18} /></a>
    </div>
  </div>

  <div class="list">
    {
      faqs.map((f, i) => (
        <details class="item" name="faq" open={i === 0} data-reveal-item>
          <summary>
            <h3 class="q">{f.q}</h3>
            <span class="toggle" aria-hidden="true">
              <Icon name="plus" size={20} class="i-plus" />
              <Icon name="minus" size={20} class="i-minus" />
            </span>
          </summary>
          <p class="a">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: flex;
    justify-content: space-around;
    gap: 72px;
    max-width: var(--max);
    margin-inline: auto;
    padding: var(--sec-y) var(--wrap-x);
  }
  .intro { display: flex; flex-direction: column; gap: 36px; width: 408px; flex: none; }
  .title { font-size: clamp(40px, 5.14vw, 74px); line-height: 1.01; letter-spacing: -0.039em; font-weight: 500; }
  .more { display: flex; flex-direction: column; gap: 6px; }
  .more p { color: var(--muted); font-size: 18px; }
  .mail { display: inline-flex; align-items: center; gap: 8px; padding: 6px 0; font-size: 19px; font-weight: 500; text-decoration: none; }
  .mail:hover { color: var(--accent); }

  .list { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .item { background: var(--white); border-bottom: 1px solid var(--line); border-radius: 16px; transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease); }
  .item summary { display: flex; align-items: center; gap: 16px; padding: 16px 28px; list-style: none; cursor: pointer; border-radius: 16px; }
  .item summary::-webkit-details-marker { display: none; }
  .q { flex: 1; transition: color 0.2s var(--ease); font-size: clamp(19px, 1.6vw, 23px); line-height: 1.26; letter-spacing: -0.022em; font-weight: 500; }
  .toggle { display: grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 22px; background: var(--surface); color: var(--text); transition: background-color 0.2s var(--ease), transform 0.2s var(--ease); }
  .toggle :global(.i-minus) { display: none; }
  .item summary:hover .toggle { background: var(--line); }
  .a { padding: 0 92px 28px 28px; color: #d4d4d0; font-size: 18px; line-height: 1.5; }

  .item[open]:not(.is-closing) { background: var(--open-bg); border-bottom-color: transparent; }
  .item[open]:not(.is-closing) summary { padding: 24px 28px 12px; }
  .item[open]:not(.is-closing) .q { color: var(--on-dark); font-size: clamp(21px, 1.88vw, 27px); }
  .item[open]:not(.is-closing) .toggle { background: var(--accent); color: var(--on-accent); transform: rotate(180deg); }
  .item[open]:not(.is-closing) .toggle :global(.i-plus) { display: none; }
  .item[open]:not(.is-closing) .toggle :global(.i-minus) { display: block; }
  .item[open]:not(.is-closing) summary:focus-visible { outline-color: var(--on-dark); }
  .item summary:focus-visible { outline-offset: -2px; }

  @media (max-width: 1000px) {
    .faq { flex-direction: column; gap: 32px; padding-inline: var(--pad-x); }
    .intro { width: auto; gap: 20px; }
  }
  @media (max-width: 640px) {
    .item summary { padding: 12px 16px; }
    .item[open]:not(.is-closing) summary { padding: 16px 16px 8px; }
    .a { padding: 0 16px 20px; font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .toggle { transition-property: background-color; }
    .item[open]:not(.is-closing) .toggle { transform: none; }
  }
</style>
