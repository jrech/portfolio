---
import Wordmark from '../ui/Wordmark.astro';
import MenuOverlay from './MenuOverlay.astro';
import LangSwitch from '../ui/LangSwitch.astro';
import { getLocale, localePath, useT } from '@/i18n';

interface Props {
  /** Sit on top of the hero (homepage) instead of taking space in the flow (case studies). */
  overlay?: boolean;
  /** Current menu item label, highlighted in the fullscreen menu. */
  current?: string;
}

const { overlay = false, current } = Astro.props;
const t = useT(Astro);
const locale = getLocale(Astro);
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <div class="site-header__inner container">
    <Wordmark />
    <!-- Desktop: minimal navigation (Pen "Portrait-led hero — Minimal navigation";
         Jonas, 2026-11-03). Tablet and mobile keep the MENU button. -->
    <nav class="site-nav" aria-label={t.a11y.mainNavigation}>
      {
        [
          { href: localePath(locale, '/#work'), label: t.nav.work },
          { href: localePath(locale, '/#about'), label: t.nav.about },
          { href: '#contact', label: t.cta.startProject, cta: true },
        ].map((item) => (
          <a
            class:list={['site-nav__link', { 'site-nav__cta': item.cta }]}
            href={item.href}
            data-inquiry-open={item.cta ? '' : undefined}
          >
            {/* Roll: the label slides up and out, its copy rises from below; reverses on leave. */}
            <span class="roll" aria-hidden="true">
              <span class="roll__track">
                <span>{item.label}</span>
                <span>{item.label}</span>
              </span>
            </span>
            <span class="visually-hidden">{item.label}</span>
          </a>
        ))
      }
      <LangSwitch class="site-nav__lang" />
    </nav>
    <button
      class="menu-toggle"
      type="button"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-open
    >
      <span class="menu-toggle__label caption" aria-hidden="true">{t.menu.open}</span>
      <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span></span>
      <span class="visually-hidden">{t.a11y.openMenu}</span>
    </button>
  </div>
</header>

<MenuOverlay current={current} />

<script>
  // Header follows the scroll direction (Jonas, 2026-10-29): it shows while scrolling
  // down and hides while scrolling up; always shown near the top. Flip SHOW_ON_DOWN
  // for the usual "hide on down, show on up".
  const SHOW_ON_DOWN = true;
  const THRESHOLD = 8;
  const header = document.querySelector<HTMLElement>('.site-header');
  const menu = document.getElementById('site-menu') as HTMLDialogElement | null;
  if (header) {
    let last = scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = Math.max(0, scrollY);
      const top = header.offsetHeight * 1.5;
      header.classList.toggle('is-scrolled', y > top);
      if (menu?.open) return;
      if (y <= top) header.classList.remove('is-hidden');
      else if (Math.abs(y - last) >= THRESHOLD) {
        const down = y > last;
        header.classList.toggle('is-hidden', down !== SHOW_ON_DOWN);
      } else return;
      last = y;
    };
    addEventListener('scroll', () => {
      if (!ticking) requestAnimationFrame(update);
      ticking = true;
    }, { passive: true });
    update();
  }
</script>

<style>
  /* Pinned to the viewport; slides away per scroll direction (script above). Case
     studies keep its space in the flow (sticky), the homepage lays it over the hero. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    transition:
      transform 450ms var(--ease-out),
      background-color 300ms var(--ease-out);
  }

  .site-header--overlay {
    position: fixed;
    inset: 0 0 auto;
  }

  /* Away from the top it needs its own backdrop to stay readable over content. */
  .site-header.is-scrolled {
    background: rgb(16 16 15 / 0.82);
    backdrop-filter: blur(12px);
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .menu-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    /* Keep the 44px hit area flush with the gutter, as in the frames. */
    margin-right: 0;
  }

  .menu-toggle__label {
    display: none;
    font-size: 10px;
    letter-spacing: 2px;
    /* Same cream as the hamburger lines: the caption grey disappeared over the hero photo. */
    color: var(--color-text-display);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .menu-toggle__icon {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 7px;
    width: 44px;
    height: 44px;
  }

  .menu-toggle__icon span {
    width: 27px;
    height: 2px;
    background: var(--color-text-display);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .menu-toggle:hover .menu-toggle__label,
  .menu-toggle:focus-visible .menu-toggle__label {
    color: var(--color-accent);
  }

  .menu-toggle:hover .menu-toggle__icon span:last-child {
    transform: translateX(-4px);
  }

  .site-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }

    .site-nav {
      display: flex;
      align-items: center;
      gap: 32px;
      height: 44px;
    }

    .site-nav__link {
      position: relative;
      font-size: 15px;
      font-weight: var(--weight-bold);
      line-height: normal;
      text-transform: uppercase;
      color: var(--color-text-secondary);
      transition: color var(--duration-fast) var(--ease-out);
    }

    .roll {
      display: block;
      overflow: hidden;
      height: 1.3em;
      line-height: 1.3;
    }

    .roll__track {
      display: flex;
      flex-direction: column;
      transition: transform 550ms cubic-bezier(0.76, 0, 0.24, 1);
    }

    .roll__track > span {
      display: block;
      height: 1.3em;
    }

    /* The incoming copy is the hover colour. */
    .roll__track > span + span {
      color: var(--color-text-display);
    }

    .site-nav__link:hover .roll__track,
    .site-nav__link:focus-visible .roll__track {
      transform: translateY(-50%);
    }

    .site-nav__cta {
      color: var(--color-accent);
    }

    @media (prefers-reduced-motion: reduce) {
      .roll__track {
        transition: none;
      }
    }

    .site-nav :global(.site-nav__lang) {
      padding-left: 32px;
      border-left: 1px solid var(--color-rule);
    }
  }
</style>
