---
/**
 * Contact invitation + footer (Pen: "Contact and footer" / "Case study final CTA and footer").
 *
 * variant="centered" — homepage: centered invitation on desktop (Cream rhythm frame).
 * variant="split"    — case studies: headline left, CTA right on desktop.
 * Both collapse to the same left-aligned stack on tablet and mobile.
 */
import CtaButton from '../ui/CtaButton.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import LangSwitch from '../ui/LangSwitch.astro';
import { footerNav, site, socials } from '@/data/site';
import { getLocale, localePath, useT } from '@/i18n';

const t = useT(Astro);
const locale = getLocale(Astro);

interface Props {
  variant?: 'centered' | 'split';
  index?: string;
  eyebrow?: string;
  headline?: string;
  lead?: string;
}

const {
  variant = 'centered',
  index = '[06]',
  eyebrow = t.footer.eyebrow,
  headline = t.footer.headline,
  lead = t.footer.lead,
} = Astro.props;

const bio = t.footer.bio;
---

<footer id="contact" class:list={['footer', `footer--${variant}`]}>
  <div class="footer__inner container">
    <section class="footer__invite" aria-labelledby="footer-title">
      <Eyebrow index={index} class="footer__eyebrow footer__eyebrow--indexed">{eyebrow}</Eyebrow>
      <Eyebrow accent class="footer__eyebrow footer__eyebrow--accent">{eyebrow.toUpperCase()}</Eyebrow>
      <div class="footer__invite-main">
        <h2 id="footer-title" class="footer__title" data-reveal="heading">{headline}</h2>
        <CtaButton href="#contact" label={t.cta.startProject} />
      </div>
      {lead && <p class="footer__lead">{lead}</p>}
    </section>

    <div class="footer__contact">
      <p class="footer__bio">{bio}</p>
      <a class="footer__email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>

    <nav class="footer__nav" aria-label={t.a11y.footerNavigation}>
      <div class="footer__col">
        <p class="footer__col-label caption" id="footer-explore">{t.footer.explore}</p>
        <ul class="footer__links" role="list" aria-labelledby="footer-explore">
          {
            footerNav(t, locale).map((item) => (
              <li>
                <a class="footer__link" href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="footer__col">
        <p class="footer__col-label caption" id="footer-elsewhere">{t.footer.elsewhere}</p>
        <ul class="footer__links footer__links--social" role="list" aria-labelledby="footer-elsewhere">
          {
            socials.map((s) => (
              <li>
                <a class="footer__link footer__social" href={s.href} rel="noopener">
                  {s.label}
                  <Icon name={s.icon} size={16} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="footer__legal">
      <p class="caption">© {site.year} JONAS RECH</p>
      <a class="footer__small" href={localePath(locale, '/privacy')}>{t.footer.privacy}</a>
      <LangSwitch class="footer__lang" />
      <a class="footer__small footer__top" href="#top">{t.footer.backToTop}</a>
    </div>
  </div>
</footer>

<style>
  /* ---------- Mobile (390 frame) ---------- */
  .footer {
    border-top: 1px solid var(--color-rule);
    background: var(--color-background);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-block: 64px;
  }

  .footer__invite {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  /* Eyebrow is a child component: reach its root through :global(). */
  .footer :global(.footer__eyebrow--accent) {
    display: none;
  }

  .footer__invite-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  .footer__title {
    align-self: stretch;
    font-family: var(--font-display);
    font-size: 42px;
    font-weight: var(--weight-medium);
    line-height: 1.02;
    letter-spacing: -1.6px;
    color: var(--color-text-primary);
  }

  /* Supporting line only appears in the centered desktop and split case-study frames. */
  .footer__lead {
    display: none;
    font-size: 18px;
    line-height: normal;
    color: var(--color-text-secondary);
  }

  .footer--split .footer__lead {
    display: block;
    font-size: 16px;
  }

  /* Email → nav is 40px in every frame; the outer stack gap differs per breakpoint. */
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 4px;
  }

  .footer__bio {
    display: none;
  }

  .footer__email {
    width: fit-content;
    font-size: 21px;
    letter-spacing: -0.4px;
    line-height: normal;
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__email:hover,
  .footer__email:focus-visible {
    color: var(--color-text-primary);
  }

  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 16px;
  }

  .footer__col-label {
    display: none;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    list-style: none;
    padding: 0;
  }

  .footer__links--social {
    gap: 28px;
  }

  .footer__link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    line-height: normal;
    color: var(--color-text-primary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__social {
    font-size: 15px;
  }

  .footer__social :global(svg) {
    stroke-width: 1.75;
  }

  .footer__link:hover,
  .footer__link:focus-visible,
  .footer__small:hover,
  .footer__small:focus-visible {
    color: var(--color-accent);
  }

  .footer__legal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--color-rule);
  }

  .footer__small {
    font-size: 12px;
    line-height: normal;
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__top {
    color: var(--color-text-primary);
  }

  /* Mobile frame order: copyright, privacy, back to top, language. */
  .footer__lang {
    order: 4;
    letter-spacing: 1.1px;
  }

  /* ---------- Tablet (834 frame) ---------- */
  @media (min-width: 640px) {
    .footer__inner {
      gap: 44px;
      padding-block: 80px;
    }

    .footer__invite {
      gap: 44px;
    }

    .footer__title {
      font-size: 56px;
      letter-spacing: -2px;
    }

    .footer--split .footer__lead {
      font-size: 18px;
    }

    .footer__contact {
      margin-bottom: -4px;
    }

    .footer__email {
      font-size: 26px;
    }

    .footer__links {
      gap: 28px;
    }

    .footer__link {
      font-size: 15px;
    }

    .footer__legal {
      flex-direction: row;
      justify-content: space-between;
    }

    .footer__lang {
      order: 0;
    }
  }

  /* ---------- Desktop (1440 frame) ---------- */
  @media (min-width: 1024px) {
    .footer__email {
      font-size: 22px;
    }

    .footer__legal {
      align-items: center;
    }

    /* Split (case study): headline + CTA on one row. */
    .footer--split .footer__inner {
      gap: 48px;
    }

    .footer--split .footer__invite {
      gap: 48px;
    }

    .footer--split .footer__contact {
      margin-bottom: -8px;
    }

    .footer--split .footer__invite-main {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 64px;
    }

    .footer--split .footer__title {
      flex: 1;
      font-size: 64px;
      line-height: 65px;
      letter-spacing: -2.8px;
    }

    .footer--split .footer__nav {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    /* Centered (homepage, Cream rhythm frame). */
    .footer--centered .footer__inner {
      gap: 0;
      padding-top: 0;
      padding-bottom: 32px;
    }

    .footer--centered .footer__invite {
      align-items: center;
      gap: 26px;
      padding: 104px 160px 108px;
      text-align: center;
    }

    .footer--centered :global(.footer__eyebrow--indexed) {
      display: none;
    }

    .footer--centered :global(.footer__eyebrow--accent) {
      display: flex;
    }

    .footer--centered .footer__invite-main {
      display: contents;
    }

    /* Frame breaks the line after "something" (explicit <br> in the export). */
    .footer--centered .footer__title {
      align-self: center;
      max-width: 560px;
      font-size: 80px;
      line-height: 80px;
      letter-spacing: -3.5px;
    }

    .footer--centered .footer__lead {
      display: block;
      order: 1;
    }

    .footer--centered :global(.cta) {
      order: 2;
    }

    .footer--centered .footer__contact {
      align-items: center;
      gap: 20px;
      margin: 0;
    }

    .footer--centered .footer__bio {
      display: block;
      max-width: 696px;
      font-size: 17px;
      line-height: 26px;
      text-align: center;
      color: var(--color-text-secondary);
    }

    .footer--centered .footer__email {
      font-size: 36px;
      font-weight: var(--weight-medium);
      letter-spacing: -1px;
      color: var(--color-text-primary);
    }

    .footer--centered .footer__email:hover,
    .footer--centered .footer__email:focus-visible {
      color: var(--color-accent);
    }

    .footer--centered .footer__nav {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      margin-top: 48px;
      padding-top: 36px;
      padding-bottom: 48px;
      border-top: 1px solid var(--color-rule);
    }

    .footer--centered .footer__col-label {
      display: block;
      margin-bottom: 14px;
      font-size: 10px;
    }

    .footer--centered .footer__links {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>
