---
/**
 * Contact invitation + footer (Pen: "2. Big links bar footer").
 * Centered invitation and CTA, the email as a big link, a numbered sitemap bar
 * with socials, and the legal baseline. Used on the homepage and case studies
 * (which pass their own headline and lead).
 */
import CtaButton from '../ui/CtaButton.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import LangSwitch from '../ui/LangSwitch.astro';
import { footerNav, site, socials } from '@/data/site';
import { getLocale, localePath, useT } from '@/i18n';

const t = useT(Astro);
const locale = getLocale(Astro);

interface Props {
  eyebrow?: string;
  headline?: string;
  lead?: string;
}

const { eyebrow = t.footer.eyebrow, headline = t.footer.headline, lead = t.footer.lead } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<footer id="contact" class="footer footer--centered">
  <!-- Flowing orange aurora (WebGL2, scripts/aurora.ts) that leans toward the mouse
       and brightens while a link is hovered.
       Without WebGL2 the footer stays plain. -->
  <div class="footer__ambient" aria-hidden="true" data-footer-aurora></div>
  <div class="footer__inner container">
    <section class="footer__invite" aria-labelledby="footer-title">
      <Eyebrow accent class="footer__eyebrow">{eyebrow.toUpperCase()}</Eyebrow>
      <h2 id="footer-title" class="footer__title" data-reveal="heading">{headline}</h2>
      {lead && <p class="footer__lead">{lead}</p>}
      <CtaButton href="#contact" label={t.cta.startProject} />
    </section>

    <div class="footer__contact">
      <p class="caption caption--accent">{t.footer.writeMe}</p>
      <a class="footer__email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>

    <nav class="footer__nav" aria-label={t.a11y.footerNavigation}>
      <ul class="footer__links" role="list">
        {
          footerNav(t, locale).map((item, i) => (
            <li>
              <a class="footer__link" href={item.href}>
                <span class="footer__index" aria-hidden="true">{pad(i + 1)}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="footer__socials" role="list">
        {
          socials.map((s) => (
            <li>
              <a class="footer__social" href={s.href} rel="noopener">
                {s.label}
                <span class="footer__badge" aria-hidden="true"><Icon name="arrow-up-right" size={10} /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__legal">
      <p class="caption footer__copy">© {site.year} JONAS RECH</p>
      <div class="footer__legal-mid">
        <a class="footer__small" href={localePath(locale, '/privacy')}>{t.footer.privacy}</a>
        <p class="caption">{t.footer.location}</p>
      </div>
      <div class="footer__legal-end">
        <LangSwitch class="footer__lang" />
        <a class="footer__small footer__top" href="#top">{t.footer.backToTop}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* ---------- Mobile ---------- */
  .footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid var(--color-rule);
    background: var(--color-background);
  }

  /* ---------- Ambient aurora ---------- */
  .footer__ambient {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .footer__ambient.is-ready {
    opacity: 1;
  }

  .footer__ambient :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    transition: filter 600ms var(--ease-out);
  }

  @media (hover: hover) {
    .footer:has(a:hover) .footer__ambient :global(canvas) {
      filter: brightness(1.15) saturate(1.05);
    }
  }

  /* Vignette keeps the copy readable over the light. */
  .footer__ambient::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 30% 40%,
      rgb(16 16 15 / 0.55) 0%,
      rgb(16 16 15 / 0.2) 45%,
      transparent 75%
    );
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    padding-bottom: 32px;
    text-align: center;
  }

  .footer__invite {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding-block: 96px 56px;
  }

  .footer__title {
    max-width: 560px;
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: var(--weight-medium);
    line-height: 1;
    letter-spacing: var(--heading-tracking);
    color: var(--color-text-primary);
  }

  .footer__lead {
    font-size: 17px;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  .footer__invite :global(.cta) {
    margin-top: 4px;
  }

  .footer__contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding-block: 40px 48px;
  }

  .footer__email {
    font-family: var(--font-display);
    font-size: clamp(28px, 8.2vw, 64px);
    font-weight: var(--weight-medium);
    line-height: 1.1;
    letter-spacing: var(--heading-tracking);
    color: var(--color-text-primary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__email:hover,
  .footer__email:focus-visible {
    color: var(--color-accent);
  }

  /* ---------- Sitemap bar ---------- */
  .footer__nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding-block: 26px 36px;
  }

  .footer__links,
  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 28px;
    padding: 0;
    list-style: none;
  }

  .footer__socials {
    gap: 24px;
  }

  .footer__link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    color: var(--color-text-primary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__index {
    font-family: var(--font-caption);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-accent);
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* Small filled square with the arrow knocked out (Pen social links). */
  .footer__badge {
    display: grid;
    place-items: center;
    width: 12px;
    height: 12px;
    border-radius: 2px;
    background: currentColor;
  }

  .footer__badge :global(svg) {
    color: var(--color-background);
    stroke-width: 3;
  }

  .footer__link:hover,
  .footer__link:focus-visible,
  .footer__social:hover,
  .footer__social:focus-visible,
  .footer__small:hover,
  .footer__small:focus-visible {
    color: var(--color-accent);
  }

  /* ---------- Legal baseline ---------- */
  .footer__legal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--color-rule);
  }

  .footer__legal-mid,
  .footer__legal-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 28px;
  }

  .footer__small {
    font-size: 12px;
    line-height: normal;
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__top {
    color: var(--color-text-primary);
  }

  .footer__lang {
    letter-spacing: 1.1px;
  }

  /* ---------- Tablet ---------- */
  @media (min-width: 640px) {
    .footer__invite {
      padding-block: 120px 56px;
    }

    .footer__title {
      font-size: 64px;
      letter-spacing: var(--heading-tracking);
    }

    .footer__lead {
      font-size: 18px;
    }
  }

  /* ---------- Desktop (1440 frame) ---------- */
  @media (min-width: 1024px) {
    .footer__invite {
      gap: 26px;
      padding: 120px 160px 72px;
    }

    .footer__title {
      font-size: 80px;
      letter-spacing: var(--heading-tracking);
    }

    .footer__contact {
      gap: 18px;
      padding-block: 56px 48px;
    }

    .footer__email {
      letter-spacing: var(--heading-tracking);
    }

    .footer__nav {
      flex-direction: row;
      justify-content: space-between;
    }

    .footer__links {
      gap: 36px;
    }

    .footer__legal {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .footer__copy {
      justify-self: start;
    }

    .footer__legal-end {
      justify-self: end;
    }
  }
</style>

<script>
  // Load the WebGL aurora only when the footer gets close to the viewport.
  const host = document.querySelector<HTMLElement>('[data-footer-aurora]');
  if (host) {
    const observer = new IntersectionObserver(
      async ([entry]) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        const { mountAurora } = await import('@/scripts/aurora');
        const mounted = mountAurora(host, {
          colorStops: ['#c93b00', '#5e0a00', '#ff6027'],
          amplitude: 1.5,
          blend: 0.53,
          height: 0.59,
          speed: 1,
          glow: 0.5,
          scale: 0.8,
          direction: 'bottom',
        });
        if (mounted) host.classList.add('is-ready');
      },
      { rootMargin: '400px 0px' },
    );
    observer.observe(host);
  }
</script>
