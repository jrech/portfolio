---
/**
 * Contact invitation + footer (Pen: "Contact and footer" / "Case study final CTA and footer").
 *
 * variant="centered" — homepage: centered invitation on desktop (Cream rhythm frame).
 * variant="split"    — case studies: headline left, CTA right on desktop.
 * Both collapse to the same left-aligned stack on tablet and mobile.
 */
import CtaButton from '../ui/CtaButton.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import LangSwitch from '../ui/LangSwitch.astro';
import { footerNav, site, socials } from '@/data/site';
import { getLocale, localePath, useT } from '@/i18n';

const t = useT(Astro);
const locale = getLocale(Astro);

interface Props {
  variant?: 'centered' | 'split';
  index?: string;
  eyebrow?: string;
  headline?: string;
  lead?: string;
}

const {
  variant = 'centered',
  index = '[06]',
  eyebrow = t.footer.eyebrow,
  headline = t.footer.headline,
  lead = t.footer.lead,
} = Astro.props;

const bio = t.footer.bio;
---

<footer id="contact" class:list={['footer', `footer--${variant}`]}>
  <!-- Ambient light ported from the live site: two drifting accent glows that lean
       toward the cursor and brighten over links (pointer logic in motion.ts). -->
  <div class="footer__ambient" aria-hidden="true"><span></span><span></span></div>
  <div class="footer__inner container">
    <section class="footer__invite" aria-labelledby="footer-title">
      <Eyebrow index={index} class="footer__eyebrow footer__eyebrow--indexed">{eyebrow}</Eyebrow>
      <Eyebrow accent class="footer__eyebrow footer__eyebrow--accent">{eyebrow.toUpperCase()}</Eyebrow>
      <div class="footer__invite-main">
        <h2 id="footer-title" class="footer__title" data-reveal="heading">{headline}</h2>
        <CtaButton href="#contact" label={t.cta.startProject} />
      </div>
      {lead && <p class="footer__lead">{lead}</p>}
    </section>

    <div class="footer__contact">
      <p class="footer__bio">{bio}</p>
      <a class="footer__email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>

    <nav class="footer__nav" aria-label={t.a11y.footerNavigation}>
      <div class="footer__col">
        <p class="footer__col-label caption" id="footer-explore">{t.footer.explore}</p>
        <ul class="footer__links" role="list" aria-labelledby="footer-explore">
          {
            footerNav(t, locale).map((item) => (
              <li>
                <a class="footer__link" href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="footer__col">
        <p class="footer__col-label caption" id="footer-elsewhere">{t.footer.elsewhere}</p>
        <ul class="footer__links footer__links--social" role="list" aria-labelledby="footer-elsewhere">
          {
            socials.map((s) => (
              <li>
                <a class="footer__link footer__social" href={s.href} rel="noopener">
                  {s.label}
                  <Icon name={s.icon} size={16} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="footer__legal">
      <p class="caption">© {site.year} JONAS RECH</p>
      <a class="footer__small" href={localePath(locale, '/privacy')}>{t.footer.privacy}</a>
      <LangSwitch class="footer__lang" />
      <a class="footer__small footer__top" href="#top">{t.footer.backToTop}</a>
    </div>
  </div>
</footer>

<style>
  /* ---------- Mobile (390 frame) ---------- */
  .footer {
    --follow-x: 0px;
    --follow-y: 0px;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid var(--color-rule);
    background: var(--color-background);
  }

  /* ---------- Ambient glow ---------- */
  .footer__ambient {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Extra warmth while a link or the CTA is hovered (.is-pulse, motion.ts). */
  .footer__ambient::before {
    content: '';
    position: absolute;
    z-index: 3;
    inset: -18%;
    background:
      radial-gradient(ellipse at 12% 72%, rgb(255 77 24 / 0.52), transparent 34%),
      radial-gradient(ellipse at 88% 62%, rgb(255 77 24 / 0.42), transparent 36%);
    opacity: 0;
    mix-blend-mode: screen;
    transition: opacity 420ms var(--ease-out);
  }

  .footer.is-pulse .footer__ambient::before {
    opacity: 0.32;
  }

  /* Vignette keeps the copy readable over the glow. */
  .footer__ambient::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgb(16 16 15 / 0.74) 0%,
      rgb(16 16 15 / 0.48) 38%,
      rgb(16 16 15 / 0.12) 70%,
      var(--color-background) 96%
    );
  }

  .footer__ambient span {
    position: absolute;
    width: 124vw;
    height: clamp(48rem, 116vh, 120rem);
    border-radius: 42% 58% 63% 37% / 57% 44% 56% 43%;
    filter: blur(4rem);
    opacity: 0.34;
    will-change: transform, opacity;
  }

  .footer__ambient span:first-child {
    top: 3%;
    left: -72%;
    background:
      radial-gradient(ellipse at 61% 50%, rgb(255 77 24 / 0.96) 0%, rgb(205 53 13 / 0.76) 13%, rgb(120 32 8 / 0.5) 32%, rgb(49 16 6 / 0.24) 54%, transparent 75%),
      radial-gradient(ellipse at 78% 70%, rgb(255 115 42 / 0.42), transparent 56%);
    animation: footer-light-left 16s ease-in-out infinite alternate;
  }

  .footer__ambient span:last-child {
    top: 18%;
    right: -75%;
    border-radius: 61% 39% 46% 54% / 38% 55% 45% 62%;
    background:
      radial-gradient(ellipse at 39% 46%, rgb(255 77 24 / 0.9) 0%, rgb(191 48 11 / 0.7) 15%, rgb(105 28 8 / 0.43) 35%, rgb(43 15 6 / 0.2) 56%, transparent 76%),
      radial-gradient(ellipse at 30% 72%, rgb(255 131 51 / 0.34), transparent 58%);
    animation: footer-light-right 18s ease-in-out infinite alternate;
  }

  @keyframes footer-light-left {
    from { transform: translate3d(calc(-6% + var(--follow-x)), calc(1% + var(--follow-y)), 0) scale(0.96) rotate(-2deg); opacity: 0.4; }
    to { transform: translate3d(calc(14% + var(--follow-x)), calc(9% + var(--follow-y)), 0) scale(1.08) rotate(2deg); opacity: 0.58; }
  }

  @keyframes footer-light-right {
    from { transform: translate3d(calc(5% + var(--follow-x)), calc(6% + var(--follow-y)), 0) scale(1.06) rotate(1deg); opacity: 0.54; }
    to { transform: translate3d(calc(-14% + var(--follow-x)), calc(-4% + var(--follow-y)), 0) scale(0.95) rotate(-2deg); opacity: 0.4; }
  }

  @media (min-width: 640px) {
    .footer__ambient span {
      width: clamp(70rem, 82vw, 220rem);
      filter: blur(clamp(4rem, 7vw, 16rem));
      opacity: 0.5;
    }

    .footer__ambient span:first-child {
      top: 16%;
      left: -46%;
    }

    .footer__ambient span:last-child {
      top: 9%;
      right: -46%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__ambient span {
      animation: none;
    }
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: 96px 48px;
  }

  .footer__invite {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  /* Eyebrow is a child component: reach its root through :global(). */
  .footer :global(.footer__eyebrow--accent) {
    display: none;
  }

  .footer__invite-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  .footer__title {
    align-self: stretch;
    font-family: var(--font-display);
    font-size: 42px;
    font-weight: var(--weight-medium);
    line-height: 1.02;
    letter-spacing: -1.6px;
    color: var(--color-text-primary);
  }

  /* Supporting line only appears in the centered desktop and split case-study frames. */
  .footer__lead {
    display: none;
    font-size: 18px;
    line-height: normal;
    color: var(--color-text-secondary);
  }

  .footer--split .footer__lead {
    display: block;
    font-size: 16px;
  }

  /* Email → nav is 40px in every frame; the outer stack gap differs per breakpoint. */
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 4px;
  }

  .footer__bio {
    display: none;
  }

  .footer__email {
    width: fit-content;
    font-size: 21px;
    letter-spacing: -0.4px;
    line-height: normal;
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__email:hover,
  .footer__email:focus-visible {
    color: var(--color-text-primary);
  }

  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 16px;
  }

  .footer__col-label {
    display: none;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    list-style: none;
    padding: 0;
  }

  .footer__links--social {
    gap: 28px;
  }

  .footer__link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    line-height: normal;
    color: var(--color-text-primary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__social {
    font-size: 15px;
  }

  .footer__social :global(svg) {
    stroke-width: 1.75;
  }

  .footer__link:hover,
  .footer__link:focus-visible,
  .footer__small:hover,
  .footer__small:focus-visible {
    color: var(--color-accent);
  }

  .footer__legal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--color-rule);
  }

  .footer__small {
    font-size: 12px;
    line-height: normal;
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__top {
    color: var(--color-text-primary);
  }

  /* Mobile frame order: copyright, privacy, back to top, language. */
  .footer__lang {
    order: 4;
    letter-spacing: 1.1px;
  }

  /* ---------- Tablet (834 frame) ---------- */
  @media (min-width: 640px) {
    .footer__inner {
      gap: 72px;
      padding-block: 120px 56px;
    }

    .footer__invite {
      gap: 44px;
    }

    .footer__title {
      font-size: 56px;
      letter-spacing: -2px;
    }

    .footer--split .footer__lead {
      font-size: 18px;
    }

    .footer__contact {
      margin-bottom: -4px;
    }

    .footer__email {
      font-size: 26px;
    }

    .footer__links {
      gap: 28px;
    }

    .footer__link {
      font-size: 15px;
    }

    .footer__legal {
      flex-direction: row;
      justify-content: space-between;
    }

    .footer__lang {
      order: 0;
    }
  }

  /* ---------- Desktop (1440 frame) ---------- */
  @media (min-width: 1024px) {
    .footer__email {
      font-size: 22px;
    }

    .footer__legal {
      align-items: center;
    }

    /* Split (case study): headline + CTA on one row. */
    .footer--split .footer__inner {
      gap: 48px;
    }

    .footer--split .footer__invite {
      gap: 48px;
    }

    .footer--split .footer__contact {
      margin-bottom: -8px;
    }

    .footer--split .footer__invite-main {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 64px;
    }

    .footer--split .footer__title {
      flex: 1;
      font-size: 64px;
      line-height: 65px;
      letter-spacing: -2.8px;
    }

    .footer--split .footer__nav {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    /* Centered (homepage, Cream rhythm frame). */
    .footer--centered .footer__inner {
      gap: 0;
      padding-top: 0;
      padding-bottom: 32px;
    }

    .footer--centered .footer__invite {
      align-items: center;
      gap: 32px;
      padding: 160px 160px 168px;
      text-align: center;
    }

    .footer--centered :global(.footer__eyebrow--indexed) {
      display: none;
    }

    .footer--centered :global(.footer__eyebrow--accent) {
      display: flex;
    }

    .footer--centered .footer__invite-main {
      display: contents;
    }

    /* Frame breaks the line after "something" (explicit <br> in the export). */
    .footer--centered .footer__title {
      align-self: center;
      max-width: 560px;
      font-size: 80px;
      line-height: 80px;
      letter-spacing: -3.5px;
    }

    .footer--centered .footer__lead {
      display: block;
      order: 1;
    }

    .footer--centered :global(.cta) {
      order: 2;
    }

    .footer--centered .footer__contact {
      align-items: center;
      gap: 24px;
      margin: 0;
    }

    .footer--centered .footer__bio {
      display: block;
      max-width: 696px;
      font-size: 17px;
      line-height: 26px;
      text-align: center;
      color: var(--color-text-secondary);
    }

    .footer--centered .footer__email {
      font-size: 36px;
      font-weight: var(--weight-medium);
      letter-spacing: -1px;
      color: var(--color-text-primary);
    }

    .footer--centered .footer__email:hover,
    .footer--centered .footer__email:focus-visible {
      color: var(--color-accent);
    }

    .footer--centered .footer__nav {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      margin-top: 112px;
      padding-top: 56px;
      padding-bottom: 80px;
      border-top: 1px solid var(--color-rule);
    }

    .footer--centered .footer__col-label {
      display: block;
      margin-bottom: 20px;
      font-size: 10px;
    }

    .footer--centered .footer__links {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>
