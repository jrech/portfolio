---
import { getLocale, isHome, localeLinks, translator } from '../i18n';
const t = translator(Astro.currentLocale);
import { Image } from 'astro:assets';
import CtaButton from './CtaButton.astro';
import headshot from '../assets/img/jonas-headshot.webp';
import Icon from './Icon.astro';

interface Props {
  /** podstránka má vlastní sekci Kontakt → CTA otevře formulář na místě */
  hasContact?: boolean;
}
const { hasContact = false } = Astro.props;
const home = isHome(Astro.url.pathname) ? '' : localeLinks('/')[getLocale(Astro.currentLocale)];
const ctaHref = home && !hasContact ? home + '#kontakt' : '#kontakt';

const links = [
  { href: '#prace', label: t('Vybrané práce', 'Selected work') },
  { href: '#pro-koho', label: t('Pro koho', 'Who it’s for') },
  { href: '#spoluprace', label: t('Jak spolupráce probíhá', 'How it works') },
  { href: '#o-mne', label: t('O mně', 'About') },
];
---

<header class="site-header">
  <nav class="nav-pill" aria-label={t('Hlavní navigace', 'Main navigation')}>
    <a class="logo" href={home || '#obsah'} aria-label={t('Jonáš Rech – úvod', 'Jonáš Rech – home')}>
      <Image src={headshot} alt="" width={44} height={44} densities={[1, 2]} loading="eager" />
    </a>
    <ul class="links" id="nav-links">
      {links.map((l) => <li><a href={home + l.href}>{l.label}</a></li>)}
      <li class="menu-cta on-dark">
        <CtaButton size="sm" full href={ctaHref} openForm={!home || hasContact} />
      </li>
    </ul>
    <CtaButton size="sm" class="nav-cta" href={ctaHref} openForm={!home || hasContact} />
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-links" data-menu-toggle>
      <span class="sr-only">Menu</span>
      <Icon name="menu" size={20} class="i-open" />
      <Icon name="x" size={20} class="i-close" />
    </button>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 24px var(--pad-x) 8px;
    pointer-events: none;
  }
  .nav-pill {
    pointer-events: auto;
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px;
    background: var(--ink);
    box-shadow: inset 0 0 0 1px var(--dark-edge);
    border-radius: 999px;
    filter: drop-shadow(0 10px 15px rgb(10 10 10 / 0.15));
  }
  .site-header.is-scrolled-away:not(:has(:focus-visible, .menu-btn[aria-expanded='true'])) {
    transform: translateY(calc(-100% - 24px));
  }
  @media (prefers-reduced-motion: no-preference) {
    .site-header { view-transition-name: site-header; transition: transform 180ms var(--ease); }
    .site-header:has(:focus-visible) { transition: none; }
    :global(html:not(.page-transition)) .nav-pill {
      animation: nav-expand 780ms var(--ease);
    }
    :global(html:not(.page-transition)) .nav-pill .logo {
      animation: nav-logo 780ms var(--ease);
    }
    :global(html:not(.page-transition)) .nav-pill > :global(:not(.logo)) {
      animation: nav-links 780ms ease-out;
    }
    .nav-pill:focus-within { clip-path: none !important; }
    .nav-pill:focus-within .logo { left: 0 !important; }
    .nav-pill:focus-within > :global(:not(.logo, .links)) { opacity: 1 !important; }
    @media (width > 960px) {
      .nav-pill:focus-within > .links { opacity: 1 !important; }
    }
  }
  @keyframes nav-expand {
    0%, 18% { clip-path: inset(0 calc(50% - 28px) round 999px); }
    to { clip-path: inset(0 0 round 999px); }
  }
  @keyframes nav-logo {
    0%, 18% { left: calc(50% - 22px); }
    to { left: 0; }
  }
  @keyframes nav-links {
    0%, 35% { opacity: 0; }
    to { opacity: 1; }
  }
  .logo {
    position: relative;
    z-index: 1;
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: var(--on-dark);
    overflow: hidden;
  }
  .logo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  .links { display: flex; gap: 28px; padding: 0 22px; }
  .menu-cta { display: none; }
  .links a {
    color: rgb(255 255 255 / 0.85);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }
  .links a:hover { color: var(--on-dark); }
  .links a:focus-visible { outline-color: var(--on-dark); }
  .logo:focus-visible { outline-color: var(--on-dark); }

  .menu-btn {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 22px;
    background: rgb(255 255 255 / 0.1);
    color: var(--on-dark);
    cursor: pointer;
  }
  .menu-btn:focus-visible { outline-color: var(--on-dark); }
  .menu-btn :global(.i-close) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.i-open) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.i-close) { display: block; }

  @media (max-width: 960px) {
    .site-header { padding: 12px 12px 8px; }
    .nav-pill { width: 100%; max-width: 560px; justify-content: space-between; }
    .menu-btn { display: grid; }
    .nav-pill :global(.nav-cta) { display: none; }
    .links {
      --menu-duration: 150ms;
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 8px);
      flex-direction: column;
      gap: 0;
      padding: 8px;
      background: var(--ink);
      border-radius: 24px;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity var(--menu-duration) var(--ease), visibility 0s var(--menu-duration);
    }
    .links.is-open {
      --menu-duration: 200ms;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition-delay: 0s;
    }
    @media (prefers-reduced-motion: no-preference) {
      :global(html:not(.page-transition)) .nav-pill > .links { animation: none; }
      .links {
        transform: translateY(-8px) scale(0.97);
        transform-origin: calc(100% - 28px) top;
        transition:
          opacity var(--menu-duration) var(--ease),
          transform var(--menu-duration) var(--ease),
          visibility 0s var(--menu-duration);
      }
      .links.is-open { transform: none; }
    }
    .links a { display: block; padding: 14px 16px; font-size: 17px; }
    .menu-cta { display: block; margin-top: 8px; }
  }
</style>
