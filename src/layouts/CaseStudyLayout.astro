---
/**
 * Case-study page shell: in-flow header, hero, editorial sections with the
 * three visuals in between, optional approved testimonial, related work, split footer.
 */
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '@/components/site/SiteHeader.astro';
import SiteFooter from '@/components/site/SiteFooter.astro';
import CaseHero from '@/components/case/CaseHero.astro';
import CaseSection from '@/components/case/CaseSection.astro';
import CaseDecisions from '@/components/case/CaseDecisions.astro';
import CaseVisual from '@/components/case/CaseVisual.astro';
import RelatedWork from '@/components/case/RelatedWork.astro';
import Testimonial from '@/components/home/Testimonial.astro';
import { getRelatedProjects, isPublished, type ProjectEntry } from '@/lib/projects';
import { getLocale, useT } from '@/i18n';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { title, description, challenge, approach, solution, outcome, visuals, testimonial } = project.data;
const t = useT(Astro).case;
const related = await getRelatedProjects(project, getLocale(Astro));

/**
 * Placed visuals (any `after` set): only those, where they say, numbered by `number`.
 * Otherwise the three fixed slots, with neutral placeholders for visuals not briefed yet.
 */
const placements = ['challenge', 'approach', 'solution', 'testimonial'] as const;
type Placement = (typeof placements)[number];
const placed = visuals.some((v) => v.after);
const variants = ['full', 'responsive', 'detail'] as const;
const slots = placed
  ? []
  : variants.map((variant, i) => ({ index: i + 1, ...(visuals[i] ?? { variant, ...t.fallbackVisuals[i]! }) }));
const visualsAfter = (section: Placement) =>
  placed
    ? visuals.flatMap((v, i) => (v.after === section ? [{ ...v, index: v.number ?? i + 1 }] : []))
    : section === 'testimonial'
      ? []
      : [slots[placements.indexOf(section)]!];
---

<BaseLayout title={`${title}${t.metaTitleSuffix}`} description={description} noindex={!isPublished(project)}>
  <SiteHeader slot="header" />

  <CaseHero project={project} />

  <CaseSection id="challenge" label={t.challenge} content={challenge} />
  {visualsAfter('challenge').map((visual) => <CaseVisual {...visual} />)}

  <CaseSection id="approach" label={t.approach} content={approach} />
  {visualsAfter('approach').map((visual) => <CaseVisual {...visual} />)}

  <CaseSection id="solution" label={t.solution} content={solution}>
    {solution && solution.decisions.length > 0 && <CaseDecisions decisions={solution.decisions} />}
  </CaseSection>
  {visualsAfter('solution').map((visual) => <CaseVisual {...visual} />)}

  <CaseSection id="outcome" label={t.outcome} content={outcome} last />

  {testimonial && <Testimonial testimonial={testimonial} />}
  {visualsAfter('testimonial').map((visual, i, all) => <CaseVisual {...visual} spaced={i === all.length - 1} />)}

  <RelatedWork projects={related} />

  <SiteFooter
    slot="footer"
    headline={t.footerHeadline}
    lead={t.footerLead}
  />
</BaseLayout>
