---
import '@fontsource-variable/rethink-sans';
import '@fontsource/space-mono/700.css';
import '@/styles/global.css';
import InquiryDialog from '@/components/site/InquiryDialog.astro';
import { socials } from '@/data/site';
import { getLocale, localeMeta, locales, switchLocalePath, useT } from '@/i18n';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (unpublished case studies). */
  noindex?: boolean;
}

const t = useT(Astro);
const locale = getLocale(Astro);
const { title = t.meta.title, description = t.meta.description, noindex = false } = Astro.props;

const pathname = Astro.url.pathname;
const alternates = locales.map((l) => ({
  hreflang: localeMeta[l].htmlLang,
  href: new URL(switchLocalePath(pathname, l), Astro.site).href,
}));
const xDefault = new URL(switchLocalePath(pathname, 'cs'), Astro.site).href;
const canonical = new URL(pathname, Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jonas Rech',
  url: 'https://www.jonasrech.com',
  email: 'mailto:hello@jonasrech.com',
  jobTitle: locale === 'cs' ? 'Webdesigner a vývojář' : 'Web designer and developer',
  sameAs: socials.map((s) => s.href),
};
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10100f" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jonas Rech" />
    <meta property="og:locale" content={locale === 'cs' ? 'cs_CZ' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      // Motion start state (see src/scripts/motion.ts). Skipped for reduced motion;
      // if the script has not taken over after 4 s, the content is simply shown.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const html = document.documentElement;
        html.classList.add('js-motion');
        // First visit in this tab: the hero photo rises out of black before the rest (motion.ts).
        // Arriving from another page of the site: start under the page cover, which then lifts.
        try {
          if (sessionStorage.getItem('jr-page-enter')) {
            sessionStorage.removeItem('jr-page-enter');
            html.classList.add('page-enter');
          } else if (!sessionStorage.getItem('jr-intro-seen')) html.classList.add('intro');
        } catch {}
        setTimeout(() => html.classList.contains('motion-ready') || html.classList.remove('js-motion', 'intro', 'page-enter'), 4000);
      }
    </script>
    {
      !noindex && (
        <Fragment>
          <link rel="canonical" href={canonical} />
          {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
          <link rel="alternate" hreflang="x-default" href={xDefault} />
        </Fragment>
      )
    }
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{t.a11y.skipLink}</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <InquiryDialog />
    <div class="page-cover" aria-hidden="true"></div>

    <script>
      // Start as soon as the deferred Astro script runs; another frame of
      // waiting can expose content before its reveal state is prepared.
      if (document.documentElement.classList.contains('js-motion')) {
        import('@/scripts/motion');
      }
    </script>

    <!-- Simple Analytics: cookieless, no consent banner needed. -->
    <script async defer src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
    <noscript
      ><img
        src="https://queue.simpleanalyticscdn.com/noscript.gif"
        alt=""
        referrerpolicy="no-referrer-when-downgrade"
      /></noscript>
  </body>
</html>
