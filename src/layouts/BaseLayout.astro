---
import '@fontsource-variable/rethink-sans';
import '@fontsource/space-mono/700.css';
import '@/styles/global.css';
import { getLocale, localeMeta, locales, switchLocalePath, useT } from '@/i18n';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (unpublished case studies). */
  noindex?: boolean;
}

const t = useT(Astro);
const locale = getLocale(Astro);
const { title = t.meta.title, description = t.meta.description, noindex = false } = Astro.props;

const pathname = Astro.url.pathname;
const alternates = locales.map((l) => ({
  hreflang: localeMeta[l].htmlLang,
  href: new URL(switchLocalePath(pathname, l), Astro.site).href,
}));
const xDefault = new URL(switchLocalePath(pathname, 'cs'), Astro.site).href;
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10100f" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    {
      !noindex && (
        <Fragment>
          <link rel="canonical" href={new URL(pathname, Astro.site).href} />
          {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
          <link rel="alternate" hreflang="x-default" href={xDefault} />
        </Fragment>
      )
    }
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{t.a11y.skipLink}</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
