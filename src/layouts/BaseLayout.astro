---
import '@fontsource-variable/rethink-sans';
import '@fontsource/space-mono/700.css';
import '@/styles/global.css';
import InquiryDialog from '@/components/site/InquiryDialog.astro';
import { getLocale, localeMeta, locales, switchLocalePath, useT } from '@/i18n';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (unpublished case studies). */
  noindex?: boolean;
}

const t = useT(Astro);
const locale = getLocale(Astro);
const { title = t.meta.title, description = t.meta.description, noindex = false } = Astro.props;

const pathname = Astro.url.pathname;
const alternates = locales.map((l) => ({
  hreflang: localeMeta[l].htmlLang,
  href: new URL(switchLocalePath(pathname, l), Astro.site).href,
}));
const xDefault = new URL(switchLocalePath(pathname, 'cs'), Astro.site).href;
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10100f" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <script is:inline>
      // Motion start state (see src/scripts/motion.ts). Skipped for reduced motion;
      // if the script has not taken over after 4 s, the content is simply shown.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const html = document.documentElement;
        html.classList.add('js-motion');
        setTimeout(() => html.classList.contains('motion-ready') || html.classList.remove('js-motion'), 4000);
      }
    </script>
    {
      !noindex && (
        <Fragment>
          <link rel="canonical" href={new URL(pathname, Astro.site).href} />
          {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
          <link rel="alternate" hreflang="x-default" href={xDefault} />
        </Fragment>
      )
    }
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{t.a11y.skipLink}</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    {locale === 'cs' && <InquiryDialog />}

    <script>
      // Start as soon as the deferred Astro script runs; another frame of
      // waiting can expose content before its reveal state is prepared.
      if (document.documentElement.classList.contains('js-motion')) {
        import('@/scripts/motion');
      }
    </script>

    <!-- Simple Analytics: cookieless, no consent banner needed. -->
    <script async defer src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
    <noscript
      ><img
        src="https://queue.simpleanalyticscdn.com/noscript.gif"
        alt=""
        referrerpolicy="no-referrer-when-downgrade"
      /></noscript>
  </body>
</html>
