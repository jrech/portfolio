---
import '@fontsource-variable/rethink-sans';
import '@fontsource/space-mono/700.css';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  /** Keep the page out of search results (unpublished case studies). */
  noindex?: boolean;
}

const {
  title = 'Jonas Rech — Web design & development',
  description = 'I design and build strategic websites that make your business stand out and earn trust.',
  lang = 'en',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10100f" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
