---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/site/SiteHeader.astro';
import SiteFooter from '@/components/site/SiteFooter.astro';
import Hero from '@/components/home/Hero.astro';
import SelectedWork from '@/components/home/SelectedWork.astro';
import Proposition from '@/components/home/Proposition.astro';
import Services from '@/components/home/Services.astro';
import Testimonial from '@/components/home/Testimonial.astro';
import About from '@/components/home/About.astro';
import Process from '@/components/home/Process.astro';
import Faq from '@/components/home/Faq.astro';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '@/assets/images/jonas-portrait.webp';

// Approved for publication by the client (Jonas, 2026-10-28).
const quote = (await getEntry('projects', 'pradelna-krkonose'))?.data.testimonial;
---

<BaseLayout>
  <SiteHeader slot="header" overlay />
  <Hero>
    {/* Cover crop needs far more than the viewport width on mobile/tablet; the full file is only ~35 KB. */}
    <Image
      slot="media"
      src={portrait}
      alt=""
      loading="eager"
      fetchpriority="high"
    />
  </Hero>
  <SelectedWork />
  <Proposition />
  <Services />
  {quote && <Testimonial testimonial={quote} />}
  <About />
  <Process />
  <Faq />
  <SiteFooter slot="footer" variant="centered" />
</BaseLayout>
